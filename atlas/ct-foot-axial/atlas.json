   "name": "Fibula",
   "category": "bone",
   "parent": "foot",
   "definition": "The fibula is the slender lateral bone of the leg, bearing little weight but giving attachment to muscles and forming the lateral malleolus at the ankle."
  },
  "foot": {
   "name": "Foot",
   "category": "bone"
  },
  "metatarsal": {
   "name": "Metatarsal bone",
   "category": "bone",
   "parent": "foot",
   "definition": "The five metatarsal bones are long bones lying between the tarsus and the phalanges, forming the skeleton of the forefoot."
  },
  "phalanx-foot": {
   "name": "Phalanx of foot",
   "category": "bone",
   "parent": "foot",
   "definition": "The phalanges of the foot are fourteen in number, three for each of the lesser toes and two for the great toe."
  },
  "tarsal": {
   "name": "Tarsal bone",
   "category": "bone",
   "parent": "foot",
   "definition": "The tarsus consists of seven bones - the calcaneus, talus, navicular, cuboid and three cuneiforms - forming the posterior half of the foot and the ankle."
  },
  "tibia": {
   "name": "Tibia",
   "category": "bone",
   "parent": "foot",
   "definition": "The tibia is the medial and larger of the two bones of the leg, transmitting the weight of the body from the femur to the foot."
  }

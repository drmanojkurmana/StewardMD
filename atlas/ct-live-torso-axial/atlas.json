  },
  "urinary-bladder": {
   "name": "Urinary bladder",
   "category": "urinary",
   "parent": "torso",
   "definition": "The urinary bladder is a musculomembranous reservoir for urine situated in the pelvis behind the pubic symphysis."
  }

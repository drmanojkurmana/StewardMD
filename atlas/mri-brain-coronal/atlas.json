 "structures": {
  "amygdala": {
   "name": "Amygdala",
   "category": "deep-grey",
   "parent": "brain",
   "definition": "The amygdala is an almond-shaped grey mass in the roof of the inferior horn of the lateral ventricle, at the temporal pole."
  },
  "brain": {
   "name": "Brain",
   "category": "grey"
  },
  "brainstem": {
   "name": "Brainstem",
   "category": "grey",
   "parent": "brain",
   "definition": "The brainstem comprises the midbrain, pons and medulla oblongata."
  },
  "caudate-nucleus": {
   "name": "Caudate nucleus",
   "category": "deep-grey",
   "parent": "brain",
   "definition": "The caudate nucleus is an elongated arched mass of grey matter closely related to the lateral ventricle throughout its length."
  },
  "cerebellar-cortex": {
   "name": "Cerebellar cortex",
   "category": "grey",
   "parent": "cerebellum",
   "definition": "The cerebellar cortex is the thin grey mantle covering the cerebellum, thrown into closely set transverse folia so that its surface area greatly exceeds that of the cerebral cortex relative to its volume."
  },
  "cerebellar-white-matter": {
   "name": "Cerebellar white matter",
   "category": "white",
   "parent": "cerebellum",
   "definition": "The central white core of the cerebellum, which sends a branching sheet into each folium; the branching pattern seen on a median section is termed the arbor vitae."
  },
  "cerebellum": {
   "name": "Cerebellum",
   "category": "grey",
   "parent": "brain",
   "definition": "The cerebellum occupies the posterior cranial fossa below the tentorium cerebelli."
  },
  "cerebral-cortex": {
   "name": "Cerebral cortex",
   "category": "grey",
   "parent": "brain",
   "definition": "The cerebral cortex is the layer of grey matter covering the surface of the cerebral hemispheres, thrown into folds forming the gyri, separated by sulci."
  },
  "cerebral-white-matter": {
   "name": "Cerebral white matter",
   "category": "white",
   "parent": "brain",
   "definition": "The white matter of the cerebrum consists of myelinated fibres: projection, commissural and association."
  },
  "fourth-ventricle": {
   "name": "Fourth ventricle",
   "category": "csf",
   "parent": "brain",
   "definition": "The fourth ventricle lies between the pons and medulla in front and the cerebellum behind."
  },
  "globus-pallidus": {
   "name": "Globus pallidus",
   "category": "deep-grey",
   "parent": "brain",
   "definition": "The globus pallidus is the medial, paler part of the lentiform nucleus."
  },
  "hippocampus": {
   "name": "Hippocampus",
   "category": "deep-grey",
   "parent": "brain",
   "definition": "The hippocampus is a curved elevation of grey matter in the floor of the temporal horn of the lateral ventricle."
  },
  "lateral-ventricle": {
   "name": "Lateral ventricle",
   "category": "csf",
   "parent": "brain",
   "definition": "The lateral ventricles are two irregular cavities within the cerebral hemispheres, communicating with the third ventricle through the interventricular foramina."
  },
  "nucleus-accumbens": {
   "name": "Nucleus accumbens",
   "category": "deep-grey",
   "parent": "brain",
   "definition": "A grey mass lying where the head of the caudate nucleus and the putamen become continuous beneath the anterior limb of the internal capsule, forming the ventral part of the striatum."
  },
  "putamen": {
   "name": "Putamen",
   "category": "deep-grey",
   "parent": "brain",
   "definition": "The putamen is the outer and larger part of the striatum, separated from the globus pallidus by a lamina of white matter."
  },
  "thalamus": {
   "name": "Thalamus",
   "category": "deep-grey",
   "parent": "brain",
   "definition": "The thalamus is a large ovoid mass of grey matter forming much of the lateral wall of the third ventricle."
  },
  "third-ventricle": {
   "name": "Third ventricle",
   "category": "csf",
   "parent": "brain",
   "definition": "The third ventricle is a narrow median cleft between the two thalami."
  },
  "ventral-diencephalon": {
   "name": "Ventral diencephalon",
   "category": "deep-grey",
   "parent": "brain",
   "definition": "A COMPOSITE region, not a single named organ: the ventral diencephalic grey lying below the thalamus, which at this resolution includes the hypothalamus together with the subthalamic nucleus, substantia nigra, red nucleus and mammillary bodies. It is labelled as an aggregate BECAUSE the segmentation cannot separate those parts; naming any one of them here would be wrong."
  }
 },

  }
 },
 "structures": {
  "amygdala": {
   "name": "Amygdala",
   "category": "deep-grey",
   "parent": "brain",
   "definition": "The amygdala is an almond-shaped grey mass forming the roof and anterior wall of the tip of the inferior (temporal) horn of the lateral ventricle, deep to the uncus in the anteromedial temporal lobe, immediately anterosuperior to the head of the hippocampus."
  },
  "brain": {
   "name": "Brain",
   "category": "mixed"
  },
  "brainstem": {
   "name": "Brainstem",
   "category": "mixed",
   "parent": "brain",
   "definition": "The brainstem comprises the midbrain, pons and medulla oblongata."
  },
  "caudate-nucleus": {
   "name": "Caudate nucleus",
   "category": "deep-grey",
   "parent": "brain",
   "definition": "The caudate nucleus is an elongated arched mass of grey matter closely related to the lateral ventricle throughout its length."
  },
  "cerebellar-cortex": {
   "name": "Cerebellar cortex",
   "category": "grey",
   "parent": "cerebellum",
   "definition": "The cerebellar cortex is the thin grey mantle covering the cerebellum, thrown into closely set transverse folia, which pack a surface area of roughly half that of the cerebral cortex into about a tenth of the volume."
  },
  "cerebellar-white-matter": {
   "name": "Cerebellar white matter",
   "category": "white",
   "parent": "cerebellum",
   "definition": "The central white core of the cerebellum (corpus medullare), which sends a branching sheet into each folium; the branching pattern seen on a median section is termed the arbor vitae."
  },
  "cerebellum": {
   "name": "Cerebellum",
   "category": "mixed",
   "parent": "brain",
   "definition": "The cerebellum occupies the posterior cranial fossa below the tentorium cerebelli."
  },
  "cerebral-cortex": {
   "name": "Cerebral cortex",
   "category": "grey",
   "parent": "brain",
   "definition": "The cerebral cortex is the layer of grey matter covering the surface of the cerebral hemispheres, thrown into folds forming the gyri, separated by sulci."
  },
  "cerebral-white-matter": {
   "name": "Cerebral white matter",
   "category": "white",
   "parent": "brain",
   "definition": "The white matter of the cerebrum consists of myelinated fibres: projection, commissural and association."
  },
  "fourth-ventricle": {
   "name": "Fourth ventricle",
   "category": "csf",
   "parent": "brain",
   "definition": "The fourth ventricle lies between the pons and medulla in front and the cerebellum behind."
  },
  "globus-pallidus": {
   "name": "Globus pallidus",
   "category": "deep-grey",
   "parent": "brain",
   "definition": "The globus pallidus is the medial, paler part of the lentiform nucleus."
  },
  "hippocampus": {
   "name": "Hippocampus",
   "category": "grey",
   "parent": "brain",
   "definition": "The hippocampus is a curved elevation of grey matter in the floor of the temporal horn of the lateral ventricle. It is archicortex - a three-layered allocortex rolled into the medial temporal lobe - not a subcortical nucleus."
  },
  "lateral-ventricle": {
   "name": "Lateral ventricle",
   "category": "csf",
   "parent": "brain",
   "definition": "The lateral ventricles are two irregular cavities within the cerebral hemispheres, communicating with the third ventricle through the interventricular foramina. Each has a frontal (anterior) horn, a body, an atrium (trigone), and occipital (posterior) and inferior (temporal) horns; the pins in this atlas do not distinguish them."
  },
  "nucleus-accumbens": {
   "name": "Nucleus accumbens",
   "category": "deep-grey",
   "parent": "brain",
   "definition": "A grey mass lying where the head of the caudate nucleus and the putamen become continuous beneath the anterior limb of the internal capsule, forming the ventral part of the striatum."
  },
  "putamen": {
   "name": "Putamen",
   "category": "deep-grey",
   "parent": "brain",
   "definition": "The putamen is the outer and larger part of the lentiform nucleus, separated from the globus pallidus by the lateral medullary lamina; together with the caudate nucleus it forms the striatum."
  },
  "thalamus": {
   "name": "Thalamus",
   "category": "deep-grey",
   "parent": "brain",
   "definition": "The thalamus is a large ovoid mass of grey matter forming much of the lateral wall of the third ventricle."
  },
  "third-ventricle": {
   "name": "Third ventricle",
   "category": "csf",
   "parent": "brain",
   "definition": "The third ventricle is a narrow median cleft between the two thalami. Its floor and lower lateral walls are formed by the hypothalamus."
  },
  "ventral-diencephalon": {
   "name": "Ventral diencephalic / subthalamic region (composite)",
   "category": "mixed",
   "parent": "brain",
   "definition": "NOT a single named structure and NOT a Terminologia Anatomica term: this is the FreeSurfer \"ventral diencephalon\" segmentation label, a composite of the grey and white matter packed between the thalamus above, the internal capsule laterally and the midbrain below. It contains the hypothalamus, mammillary body and subthalamic nucleus (diencephalic), the geniculate bodies (metathalamic), the substantia nigra and red nucleus (which are MIDBRAIN, not diencephalon), the zona incerta, and fibre bundles including the medial lemniscus and lenticular fasciculus. It is shown as an aggregate because this segmentation cannot separate them: do not learn any one of these structures from this pin."
  }
 },

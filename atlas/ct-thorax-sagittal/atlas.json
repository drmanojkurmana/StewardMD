 "structures": {
  "lung": {
   "name": "Lung",
   "category": "airway",
   "parent": "thorax",
   "definition": "The lungs are the essential organs of respiration, occupying the pleural cavities on either side of the mediastinum. Each is conical, with an apex reaching above the first rib and a concave base resting on the diaphragm."
  },
  "rib": {
   "name": "Rib",
   "category": "bone",
   "parent": "thoracic-cage",
   "definition": "The ribs are elastic arches of bone forming the greater part of the thoracic skeleton. They are twelve in number on either side, articulating behind with the vertebral column."
  },
  "sternum": {
   "name": "Sternum",
   "category": "bone",
   "parent": "thoracic-cage",
   "definition": "The sternum is a flat narrow bone forming the middle of the anterior wall of the thorax, consisting of the manubrium, the body and the xiphoid process."
  },
  "thoracic-cage": {
   "name": "Thoracic cage",
   "category": "bone",
   "parent": "thorax"
  },
  "thoracic-vertebra": {
   "name": "Thoracic vertebra",
   "category": "bone",
   "parent": "thoracic-cage",
   "definition": "The thoracic vertebrae are twelve in number and are distinguished by the costal facets on the sides of their bodies for articulation with the heads of the ribs."
  },
  "thorax": {
   "name": "Thorax",
   "category": "viscus"
  },
  "vertebral-canal": {
   "name": "Vertebral canal",
   "category": "csf",
   "parent": "thoracic-vertebra",
   "definition": "The vertebral canal is formed by the vertebral foramina in series and contains the spinal cord with its meninges and vessels."
  }
 },

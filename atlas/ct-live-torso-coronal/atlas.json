   "parent": "torso",
   "definition": "The aorta is the main arterial trunk, conveying blood from the left ventricle to the body."
  },
  "autochthonous-back-muscle": {
   "name": "Deep back muscles",
   "category": "muscle",
   "parent": "torso",
   "definition": "The deep or intrinsic muscles of the back extend and rotate the vertebral column."
  },
  "colon": {
   "name": "Colon",
   "category": "gi-tract",
   "parent": "torso",
   "definition": "The colon extends from the caecum to the rectum and is distinguished by its haustra and taeniae coli."
  },
  "duodenum": {
   "name": "Duodenum",
   "category": "gi-tract",
   "parent": "torso",
   "definition": "The duodenum is the shortest, widest and most fixed part of the small intestine, curved around the head of the pancreas."
  },
  "esophagus": {
   "name": "Oesophagus",
   "category": "gi-tract",
   "parent": "torso",
   "definition": "The oesophagus is a muscular canal passing from the pharynx through the posterior mediastinum to the stomach."
  },
  "gallbladder": {
   "name": "Gallbladder",
   "category": "gi-tract",
   "parent": "torso",
   "definition": "The gallbladder is a pear-shaped reservoir for bile lodged in a fossa on the under surface of the liver."
  },
  "gluteal-muscle": {
   "name": "Gluteal muscles",
   "category": "muscle",
   "parent": "torso",
   "definition": "The gluteal muscles extend, abduct and rotate the thigh at the hip joint."
  },
  "heart": {
   "name": "Heart",
   "category": "viscus",
   "parent": "torso",
   "definition": "The heart is a hollow muscular organ enclosed in the pericardium, occupying the middle mediastinum."
  },
  "iliac-artery": {
   "name": "Iliac artery",
   "category": "vessel-artery",
   "parent": "torso",
   "definition": "The common iliac arteries arise from the aortic bifurcation and divide into external and internal iliac arteries."
  },
  "iliac-vein": {
   "name": "Iliac vein",
   "category": "vessel-vein",
   "parent": "torso",
   "definition": "The common iliac veins unite to form the inferior vena cava."
  },
  "iliopsoas": {
   "name": "Iliopsoas",
   "category": "muscle",
   "parent": "torso",
   "definition": "The iliacus and psoas major act together as the chief flexor of the thigh at the hip."
  },
  "inferior-vena-cava": {
   "name": "Inferior vena cava",
   "category": "vessel-vein",
   "parent": "torso",
   "definition": "The inferior vena cava returns blood from the lower half of the body to the right atrium."
  },
  "kidney": {
   "name": "Kidney",
   "category": "urinary",
   "parent": "torso",
   "definition": "The kidneys are situated in the posterior part of the abdomen, one on either side of the vertebral column, behind the peritoneum."
  },
  "liver": {
   "name": "Liver",
   "category": "viscus",
   "parent": "torso",
   "definition": "The liver is the largest gland in the body, occupying the right hypochondrium and extending into the epigastrium."
  },
  "lower-lobe-left": {
   "name": "Lower lobe of left lung",
   "category": "airway",
   "parent": "torso",
   "definition": "The lower lobe of the left lung lies posteroinferior to the oblique fissure."
  },
  "lower-lobe-right": {
   "name": "Lower lobe of right lung",
   "category": "airway",
   "parent": "torso",
   "definition": "The lower lobe of the right lung lies below and behind the oblique fissure."
  },
  "middle-lobe-right": {
   "name": "Middle lobe of right lung",
   "category": "airway",
   "parent": "torso",
   "definition": "The middle lobe of the right lung is a wedge lying between the horizontal and oblique fissures."
  },
  "pancreas": {
   "name": "Pancreas",
   "category": "viscus",
   "parent": "torso",
   "definition": "The pancreas is a compound racemose gland lying transversely across the posterior abdominal wall behind the stomach."
  },
  "portal-vein": {
   "name": "Portal vein",
   "category": "vessel-vein",
   "parent": "torso",
   "definition": "The portal vein conveys blood from the abdominal digestive tract and spleen to the liver."
  },
  "prostate": {
   "name": "Prostate",
   "category": "urinary",
   "parent": "torso",
   "definition": "The prostate is a firm glandular body surrounding the commencement of the male urethra."
  },
  "small-bowel": {
   "name": "Small bowel",
   "category": "gi-tract",
   "parent": "torso",
   "definition": "The jejunum and ileum form the mesenteric portion of the small intestine, suspended by the mesentery."
  },
  "spinal-cord": {
   "name": "Spinal cord",
   "category": "csf",
   "parent": "torso",
   "definition": "The spinal cord is the elongated part of the central nervous system occupying the upper two-thirds of the vertebral canal."
  },
  "spleen": {
   "name": "Spleen",
   "category": "viscus",
   "parent": "torso",
   "definition": "The spleen is a highly vascular organ situated in the left hypochondrium between the fundus of the stomach and the diaphragm."
  },
  "stomach": {
   "name": "Stomach",
   "category": "gi-tract",
   "parent": "torso",
   "definition": "The stomach is the most dilated part of the digestive tube, lying between the oesophagus and the duodenum."
  },
  "torso": {
   "name": "Torso",
   "category": "viscus"
  },
  "upper-lobe-left": {
   "name": "Upper lobe of left lung",
   "category": "airway",
   "parent": "torso",

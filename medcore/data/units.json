{
  "schema": "medcore-units/1",
  "version": "1.0.0",
  "approvalStatus": "unapproved",
  "note": "HAZ-ML-03. The allow-list of (parameter, unit) pairs Medical Core will accept, and the ONE canonical unit each parameter is expressed in. There is deliberately no heuristic, no string similarity and no 'probably mmol/L': a unit that is not listed here makes the value UNIT_UNKNOWN and the value becomes null. This exists because icu.js wardToSI converts an SI-labelled ward result BACK to conventional units, and the GHIS adapter therefore refuses to normalise at all (unitNormalised:false, sourceValue/sourceUnit kept verbatim). This table is where normalisation finally happens, once, somewhere a clinician can read it.",
  "assumedUnitNote": "assumedFrom lists the sources whose unit convention is documented IN THIS REPO (icu-autoscores.js header: creatinine/urea/glucose/bilirubin mg/dL, albumin g/dL, Na/K/Cl/HCO3 mEq/L, platelets/WBC x10^9/L, PaO2 mmHg). An unlabelled value from such a source is accepted and flagged unitAssumed:true. An unlabelled value from any other source, an adapter above all, is refused.",
  "plausibleNote": "Engineering bounds for catching a unit error or a detached lead, NOT clinical limits, and deliberately far wider than any critical threshold (the wardsynq-iomt.js convention). A creatinine reported in umol/L but labelled mg/dL lands outside these and is refused as IMPLAUSIBLE rather than scored.",
  "params": {
    "hr":       { "canonical": "bpm",      "assumedFrom": ["icu-state"], "plausible": [10, 300],
                  "units": { "bpm": 1, "/min": 1, "beats/min": 1, "min-1": 1 } },
    "sbp":      { "canonical": "mmHg",     "assumedFrom": ["icu-state"], "plausible": [30, 300],
                  "units": { "mmhg": 1, "mm[hg]": 1 } },
    "dbp":      { "canonical": "mmHg",     "assumedFrom": ["icu-state"], "plausible": [10, 200],
                  "units": { "mmhg": 1, "mm[hg]": 1 } },
    "map":      { "canonical": "mmHg",     "assumedFrom": ["icu-state"], "plausible": [20, 250],
                  "units": { "mmhg": 1, "mm[hg]": 1 } },
    "spo2":     { "canonical": "%",        "assumedFrom": ["icu-state"], "plausible": [30, 100],
                  "units": { "%": 1, "percent": 1 } },
    "rr":       { "canonical": "/min",     "assumedFrom": ["icu-state"], "plausible": [2, 80],
                  "units": { "/min": 1, "breaths/min": 1, "bpm": 1, "min-1": 1 } },
    "temp":     { "canonical": "degC",     "assumedFrom": ["icu-state"], "plausible": [25, 45],
                  "units": { "c": 1, "degc": 1, "celsius": 1, "cel": 1,
                             "f": { "factor": 0.5555555555555556, "offset": -17.77777777777778 },
                             "degf": { "factor": 0.5555555555555556, "offset": -17.77777777777778 },
                             "fahrenheit": { "factor": 0.5555555555555556, "offset": -17.77777777777778 } } },
    "gcs":      { "canonical": "points",   "assumedFrom": ["icu-state"], "plausible": [3, 15],
                  "units": { "points": 1, "": 1, "score": 1 } },
    "uop":      { "canonical": "mL/h",     "assumedFrom": ["icu-state"], "plausible": [0, 2000],
                  "units": { "ml/h": 1, "ml/hr": 1, "cc/h": 1 } },
    "weight":   { "canonical": "kg",       "assumedFrom": ["icu-state"], "plausible": [0.4, 400],
                  "units": { "kg": 1, "kgs": 1, "g": 0.001 } },
    "fio2":     { "canonical": "fraction", "assumedFrom": [], "plausible": [0.21, 1],
                  "units": { "fraction": 1, "": 1, "%": 0.01, "percent": 0.01 } },
    "lactate":  { "canonical": "mmol/L",   "assumedFrom": ["icu-state"], "plausible": [0.1, 30],
                  "units": { "mmol/l": 1, "mm": 1, "mg/dl": 0.1110 } },
    "creat":    { "canonical": "mg/dL",    "assumedFrom": ["icu-state"], "plausible": [0.1, 25],
                  "units": { "mg/dl": 1, "umol/l": 0.011312217194570135, "mg/l": 0.1 } },
    "urea":     { "canonical": "mg/dL",    "assumedFrom": ["icu-state"], "plausible": [2, 400],
                  "units": { "mg/dl": 1, "mmol/l": 2.8011 } },
    "na":       { "canonical": "mEq/L",    "assumedFrom": ["icu-state"], "plausible": [90, 200],
                  "units": { "meq/l": 1, "mmol/l": 1 } },
    "k":        { "canonical": "mEq/L",    "assumedFrom": ["icu-state"], "plausible": [1, 10],
                  "units": { "meq/l": 1, "mmol/l": 1 } },
    "cl":       { "canonical": "mEq/L",    "assumedFrom": ["icu-state"], "plausible": [60, 160],
                  "units": { "meq/l": 1, "mmol/l": 1 } },
    "hco3":     { "canonical": "mEq/L",    "assumedFrom": ["icu-state"], "plausible": [2, 60],
                  "units": { "meq/l": 1, "mmol/l": 1 } },
    "bili":     { "canonical": "mg/dL",    "assumedFrom": ["icu-state"], "plausible": [0.05, 60],
                  "units": { "mg/dl": 1, "umol/l": 0.05847953216374269 } },
    "albumin":  { "canonical": "g/dL",     "assumedFrom": ["icu-state"], "plausible": [0.5, 7],
                  "units": { "g/dl": 1, "g/l": 0.1 } },
    "plt":      { "canonical": "x10^9/L",  "assumedFrom": ["icu-state"], "plausible": [1, 2000],
                  "units": { "x10^9/l": 1, "10^9/l": 1, "k/ul": 1, "x10^3/ul": 1, "/ul": 0.001 } },
    "wbc":      { "canonical": "x10^9/L",  "assumedFrom": ["icu-state"], "plausible": [0.1, 200],
                  "units": { "x10^9/l": 1, "10^9/l": 1, "k/ul": 1, "x10^3/ul": 1, "/ul": 0.001 } },
    "hb":       { "canonical": "g/dL",     "assumedFrom": ["icu-state"], "plausible": [1, 25],
                  "units": { "g/dl": 1, "g/l": 0.1 } },
    "glucose":  { "canonical": "mg/dL",    "assumedFrom": ["icu-state"], "plausible": [10, 1500],
                  "units": { "mg/dl": 1, "mmol/l": 18.0182 } },
    "pao2":     { "canonical": "mmHg",     "assumedFrom": ["icu-state"], "plausible": [20, 700],
                  "units": { "mmhg": 1, "kpa": 7.50062 } },
    "paco2":    { "canonical": "mmHg",     "assumedFrom": ["icu-state"], "plausible": [5, 200],
                  "units": { "mmhg": 1, "kpa": 7.50062 } },
    "ph":       { "canonical": "pH",       "assumedFrom": ["icu-state"], "plausible": [6.5, 8],
                  "units": { "ph": 1, "": 1 } },
    "inr":      { "canonical": "ratio",    "assumedFrom": ["icu-state"], "plausible": [0.5, 20],
                  "units": { "ratio": 1, "": 1 } },
    "crp":      { "canonical": "mg/L",     "assumedFrom": ["icu-state"], "plausible": [0.1, 700],
                  "units": { "mg/l": 1, "mg/dl": 10 } }
  }
}

      "id": "bk2-der-102",
      "q": "A dusky red plaque that recurs at the same lip site after each painkiller dose and heals with pigmentation is?",
      "o": [
        "Contact cheilitis",
        "Fixed drug eruption",
        "Herpes labialis",
        "Erythema multiforme"
      ],
      "a": 1,
      "exp": "Fixed eruption recurs at identical sites with dusky violaceous colour and residual hyperpigmentation.",
      "r": [
        "Incorrect. That follows external contact.",
        "Correct. Same-site recurrence with pigment.",
        "Incorrect. That gives grouped vesicles.",
        "Incorrect. That gives acral targets."
      ],
      "kp": "Same-site dusky recurrence is fixed eruption.",
      "topic": "der-drug-reactions"

      "id": "bk2-der-105",
      "q": "SCORTEN prognostication in TEN counts all of the following except?",
      "o": [
        "Serum bicarbonate level",
        "Associated malignancy",
        "Eosinophil count above normal",
        "Age, detached surface, heart rate and urea-glucose-bicarbonate with malignancy"
      ],
      "a": 2,
      "exp": "SCORTEN sums seven items including age, surface, tachycardia, urea, glucose, bicarbonate and malignancy, not eosinophils.",
      "r": [
        "Incorrect. Bicarbonate is included.",
        "Incorrect. Malignancy is included.",
        "Correct. Eosinophils are not a SCORTEN item.",
        "Incorrect. Those are all SCORTEN items."
      ],
      "kp": "SCORTEN excludes eosinophil count.",
      "topic": "der-drug-reactions"

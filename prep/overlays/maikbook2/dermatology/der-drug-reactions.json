      "id": "bk2-der-106",
      "q": "The highest-risk culprit classes for SJS and TEN include?",
      "o": [
        "Probiotic capsules",
        "Aromatic anticonvulsants, allopurinol, sulfonamides and nevirapine classes",
        "Topical emollients and sunscreens",
        "Oral antihistamines"
      ],
      "a": 1,
      "exp": "SJS-TEN links strongly to aromatic antiepileptics, allopurinol, sulfa drugs and nevirapine, especially with risk HLA alleles.",
      "r": [
        "Incorrect. Probiotics are not culprits.",
        "Correct. Classic high-risk classes.",
        "Incorrect. Emollients do not trigger TEN.",
        "Incorrect. Antihistamines are not culprits."
      ],
      "kp": "Aromatic drugs and allopurinol flag SJS-TEN.",
      "topic": "der-drug-reactions"

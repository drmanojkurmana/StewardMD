      "id": "bk2-der-101",
      "q": "A symmetric red maculopapular rash starting on the trunk 10 days after a new anticonvulsant is?",
      "o": [
        "Acute graft rejection",
        "Secondaries of syphilis",
        "Exanthematous morbilliform drug eruption",
        "Viral exanthem"
      ],
      "a": 2,
      "exp": "Morbilliform drug rash erupts symmetrically 4 to 14 days after starting the culprit, the commonest drug pattern.",
      "r": [
        "Incorrect. That follows transplantation.",
        "Incorrect. That adds palmoplantar lesions.",
        "Correct. Symmetric trunk rash after new drug.",
        "Incorrect. No drug timing or exposure."
      ],
      "kp": "Symmetric rash after new drug is morbilliform.",
      "topic": "der-drug-reactions"
    },

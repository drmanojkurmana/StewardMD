      "id": "bk2-der-109",
      "q": "The single most important first step when SJS or TEN is suspected is?",
      "o": [
        "Topical steroids alone at home",
        "Waiting for spontaneous resolution",
        "Immediate withdrawal of the culprit drug with supportive burn-unit care",
        "Adding a higher dose of the same drug"
      ],
      "a": 2,
      "exp": "Stopping the trigger early plus fluids, nutrition, eye and wound care determines survival; home care alone is unsafe.",
      "r": [
        "Incorrect. Topicals alone miss systemic loss.",
        "Incorrect. Delay worsens detachment.",
        "Correct. Stop trigger and support like burns.",
        "Incorrect. Rechallenge can be fatal."
      ],
      "kp": "Suspected SJS-TEN means stop drug and support.",
      "topic": "der-drug-reactions"
    },

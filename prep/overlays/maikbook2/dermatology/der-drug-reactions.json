      "id": "bk2-der-104",
      "q": "Widespread sheet-like detachment over 30 percent with positive Nikolsky and severe mucositis indicates?",
      "o": [
        "Staphylococcal scalded skin",
        "Pemphigus vulgaris",
        "Burns",
        "Toxic epidermal necrolysis"
      ],
      "a": 3,
      "exp": "TEN is full-thickness necrolysis over 30 percent from drug-triggered keratinocyte apoptosis, needing burn-unit care.",
      "r": [
        "Incorrect. That spares mucosae in children.",
        "Incorrect. That starts orally with antibodies.",
        "Incorrect. Burns have thermal history.",
        "Correct. Extensive full-thickness drug necrosis."
      ],
      "kp": "Extensive mucosal detachment is TEN.",
      "topic": "der-drug-reactions"
    },

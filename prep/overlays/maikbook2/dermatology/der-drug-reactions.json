      "id": "bk2-der-103",
      "q": "Painful mucosal erosions with dusky skin detachment under 10 percent of body surface define?",
      "o": [
        "Stevens-Johnson syndrome",
        "Toxic epidermal necrolysis",
        "Erythema multiforme major",
        "Generalised bullous fixed eruption"
      ],
      "a": 0,
      "exp": "SJS covers under 10 percent detachment with at least two mucosal sites; overlap is 10 to 30 and TEN over 30.",
      "r": [
        "Correct. Under 10 percent with mucosae.",
        "Incorrect. That exceeds 30 percent.",
        "Incorrect. That keeps typical acral targets.",
        "Incorrect. That stays at fixed sites."
      ],
      "kp": "Under 10 percent detachment with mucosae is SJS.",
      "topic": "der-drug-reactions"
    },

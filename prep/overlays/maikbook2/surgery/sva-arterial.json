      "id": "bk2-vas-010",
      "q": "Severe abdominal pain out of proportion with atrial fibrillation and lactate rise suggests?",
      "o": [
        "Gastritis needing antacids only",
        "Biliary colic needing reassurance",
        "Constipation needing laxatives",
        "Acute embolic mesenteric ischaemia needing embolectomy"
      ],
      "a": 3,
      "exp": "Pain beyond signs with an embolic source and lactate flags superior mesenteric embolus for urgent revascularisation.",
      "r": [
        "Incorrect. Lactate warns of dying gut.",
        "Incorrect. Colic stays proportional.",
        "Incorrect. Bowels infarct without flow.",
        "Correct. Out-of-proportion pain embolises."
      ],
      "kp": "Out-of-proportion pain is mesenteric embolus.",
      "source": "ESVS mesenteric ischaemia guideline",

      "id": "bk2-vas-005",
      "q": "A 68-year-old man has a 4 cm infrarenal AAA on screening. The size triggering elective repair in men is?",
      "o": [
        "5.5 cm with ESVS and SVS backing",
        "3.0 cm in every adult",
        "10 cm before any repair",
        "Any size needs emergency surgery"
      ],
      "a": 0,
      "exp": "Five-point-five centimetres triggers repair in men while smaller aneurysms stay on ultrasound surveillance.",
      "r": [
        "Correct. Five-point-five triggers repair.",
        "Incorrect. Small sacs are watched.",
        "Incorrect. Rupture beats that size.",
        "Incorrect. Elective timing saves lives."
      ],
      "kp": "AAA repair triggers at 5.5 cm in men.",
      "source": "ESVS abdominal aortic aneurysm guideline",
      "topic": "sva-arterial"

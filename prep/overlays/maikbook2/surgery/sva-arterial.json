      "id": "bk2-vas-003",
      "q": "A diabetic with a non-healing toe ulcer and toe pressure 30 mmHg is graded for amputation risk with?",
      "o": [
        "CEAP class alone",
        "Child-Pugh score",
        "WIfI wound ischaemia infection grade",
        "Fontaine stage alone"
      ],
      "a": 2,
      "exp": "WIfI grades wound, ischaemia and infection together to predict healing and guide revascularisation in CLTI.",
      "r": [
        "Incorrect. CEAP grades veins.",
        "Incorrect. Child-Pugh grades liver.",
        "Correct. WIfI predicts healing.",
        "Incorrect. Fontaine stages claudication only."
      ],
      "kp": "WIfI grades CLTI healing.",
      "source": "SVS/ESVS/VS Global Vascular Guidelines on chronic limb-threatening ischaemia",
      "topic": "sva-arterial"

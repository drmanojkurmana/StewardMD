      "id": "bk2-vas-002",
      "q": "A new claudicant with a tight superficial femoral stenosis asks for the best first step. The guideline-backed answer is?",
      "o": [
        "Immediate bypass in every case",
        "Bed rest until pain passes",
        "Amputation to prevent ulcers",
        "Supervised exercise programme with risk control"
      ],
      "a": 3,
      "exp": "Supervised walking with smoking cessation, statin and antiplatelet care walks claudicants further before any revascularisation.",
      "r": [
        "Incorrect. Bypass suits CLTI, not first-line.",
        "Incorrect. Rest deconditions without gain.",
        "Incorrect. Limbs are saved, not removed.",
        "Correct. Exercise first with risk control."
      ],
      "kp": "Claudication starts with supervised exercise.",
      "source": "AHA/ACC peripheral artery disease guideline",
      "topic": "sva-arterial"
    },

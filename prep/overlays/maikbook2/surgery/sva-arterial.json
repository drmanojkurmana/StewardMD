      "id": "bk2-vas-009",
      "q": "A high surgical risk patient needs carotid revascularisation. The CREST-informed choice is?",
      "o": [
        "Carotid stenting in high-risk necks",
        "No treatment for risky patients",
        "Stripping leg veins",
        "Antibiotics alone"
      ],
      "a": 0,
      "exp": "CREST keeps stenting equivalent where necks or hearts forbid endarterectomy while standard-risk keeps surgery.",
      "r": [
        "Correct. Risky necks take stents.",
        "Incorrect. Risk invites strokes.",
        "Incorrect. Legs are irrelevant.",
        "Incorrect. Plaques need plumbing."
      ],
      "kp": "High risk favours carotid stenting.",
      "source": "CREST trial",
      "topic": "sva-arterial"

      "id": "bk2-vas-001",
      "q": "A 62-year-old smoker has calf pain on walking relieved by rest. The bedside test confirming peripheral arterial disease is?",
      "o": [
        "Ankle-brachial pressure index below 0.9",
        "Normal pulse examination alone",
        "Venous refill time",
        "Capillary glucose"
      ],
      "a": 0,
      "exp": "ABPI under 0.9 confirms PAD; pulses can persist through stenoses while refill and glucose never diagnose claudication.",
      "r": [
        "Correct. Low ABPI confirms disease.",
        "Incorrect. Pulses persist past stenoses.",
        "Incorrect. Refill tests veins.",
        "Incorrect. Glucose tests sugar."
      ],
      "kp": "ABPI under 0.9 confirms claudication.",
      "source": "AHA/ACC peripheral artery disease guideline",
      "topic": "sva-arterial"
    },

      "id": "bk2-vas-007",
      "q": "A patient with atrial fibrillation has a suddenly pale pulseless cold leg. The immediate Rutherford-based plan is?",
      "o": [
        "Varicose vein stripping",
        "Compression stockings alone",
        "Heparin at once with Fogarty embolectomy for viable limbs",
        "Reassurance with discharge"
      ],
      "a": 2,
      "exp": "Rutherford grades viability while immediate heparin halts propagation and embolectomy or lysis restores flow against the clock.",
      "r": [
        "Incorrect. Veins are not the problem.",
        "Incorrect. Stockings miss clots.",
        "Correct. Heparin then embolectomy.",
        "Incorrect. Ischaemia never waits."
      ],
      "kp": "ALI means heparin plus embolectomy.",
      "source": "ESVS acute limb ischaemia guideline",
      "topic": "sva-arterial"

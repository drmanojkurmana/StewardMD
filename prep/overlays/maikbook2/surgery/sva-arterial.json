      "id": "bk2-vas-008",
      "q": "A 70 percent symptomatic carotid stenosis after a minor stroke needs surgery within?",
      "o": [
        "Only after another major stroke",
        "Two weeks with NASCET backing",
        "Two years of waiting",
        "Never operate symptomatic disease"
      ],
      "a": 1,
      "exp": "NASCET benefit concentrates early, so symptomatic seventy-percent disease earns endarterectomy within a fortnight.",
      "r": [
        "Incorrect. Prevention beats recurrence.",
        "Correct. Fortnight surgery prevents strokes.",
        "Incorrect. Delay wastes the benefit.",
        "Incorrect. Symptoms demand action."
      ],
      "kp": "Symptomatic 70 percent earns fortnight CEA.",
      "source": "NASCET trial with ESVS carotid guideline",
      "topic": "sva-arterial"

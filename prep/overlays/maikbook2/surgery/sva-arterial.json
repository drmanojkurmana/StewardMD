      "id": "bk2-vas-004",
      "q": "A fit CLTI patient has a good saphenous vein. The BEST-CLI lesson for revascularisation choice is?",
      "o": [
        "No revascularisation ever helps",
        "Vein bypass beats endovascular where conduit suits",
        "Balloons always beat bypass",
        "Prosthetic beats vein always"
      ],
      "a": 1,
      "exp": "BEST-CLI favoured surgical bypass with adequate vein while endovascular keeps its place for frail or vein-less limbs.",
      "r": [
        "Incorrect. Salvage limbs are revascularised.",
        "Correct. Suitable vein bypass wins.",
        "Incorrect. Balloons serve selected cases.",
        "Incorrect. Vein outlasts prosthetic."
      ],
      "kp": "Good vein means bypass in CLTI.",
      "source": "BEST-CLI trial",
      "topic": "sva-arterial"
    },

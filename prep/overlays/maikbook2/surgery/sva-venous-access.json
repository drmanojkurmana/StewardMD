      "id": "bk2-vas-011",
      "q": "Aching leg with ankle flare and saphenous reflux on duplex is graded and treated by?",
      "o": [
        "Arterial bypass",
        "Amputation",
        "Antibiotics alone",
        "CEAP grade with truncal ablation first"
      ],
      "a": 3,
      "exp": "CEAP grades venous disease while duplex-mapped truncal reflux earns ablation first with foam for nests.",
      "r": [
        "Incorrect. Pulses are intact here.",
        "Incorrect. Limbs are saved.",
        "Incorrect. No infection is described.",
        "Correct. CEAP with ablation first."
      ],
      "kp": "CEAP with ablation treats reflux.",
      "source": "NICE varicose veins NG13 with ESVS chronic venous disease guidance",
      "topic": "sva-venous-access"

{
  "name": "stewardmd-app",
  "version": "1.0.0",
  "private": true,
  "description": "StewardMD — native iOS + Android app wrapper (Capacitor) around the StewardMD PWA. The web app itself is buildless static files at the repo root; scripts/build-www.sh assembles the runtime bundle into www/.",
  "scripts": {
    "postinstall": "patch-package",
    "test": "for f in test/*.test.mjs test/connect/*.test.mjs test/connect/*/*.test.mjs rx-build.test.mjs; do echo \"→ $f\"; node \"$f\" || exit 1; done",
    "build:www": "bash scripts/build-www.sh",
    "sync": "npm run build:www && npx cap sync",
    "ios": "npm run sync && npx cap open ios",
    "android": "npm run sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "file:local-plugins/capacitor-community-speech-recognition",
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor-firebase/app-check": "^8.3.0",
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/local-notifications": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capawesome/capacitor-file-picker": "^8.0.3",
    "@stewardmd/capacitor-app-orientation": "file:local-plugins/capacitor-app-orientation",
    "@stewardmd/capacitor-ecg-digitiser": "file:local-plugins/capacitor-ecg-digitiser",
    "@stewardmd/capacitor-fundx-depth": "file:local-plugins/capacitor-fundx-depth",
    "@stewardmd/capacitor-vision-ocr": "file:local-plugins/capacitor-vision-ocr",
    "@stewardmd/capacitor-watch-bridge": "file:local-plugins/capacitor-watch-bridge",
    "@stewardmd/capacitor-whisper": "file:local-plugins/capacitor-whisper",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "fflate": "^0.8.3",
    "motion": "^12.43.0"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}

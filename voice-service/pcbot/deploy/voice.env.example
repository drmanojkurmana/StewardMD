# StewardMD FollowCare voice bot - production environment (systemd EnvironmentFile).
# Copy to voice.env, FILL the blanks, keep it OUT of git. Format: KEY=VALUE (no quotes, no export).

# --- Sarvam (STT / LLM / TTS) ---
SARVAM_API_KEY=
SARVAM_LLM=sarvam-105b-conversations
SARVAM_EXTRACT_LLM=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_SPEAKER=anushka
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_PACE=0.9
SARVAM_LOUDNESS=1.3

# --- Plivo (telephony) ---
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM=

# --- FollowCare (clinical source of truth; posts results here) ---
FOLLOWCARE_BASE=https://stewardmd.pages.dev/api/followcare
FOLLOWCARE_VOICE_SERVICE_TOKEN=

# --- Public endpoint Plivo reaches (the Cloudflare tunnel hostname) ---
VOICE_PUBLIC_BASE=https://voice.stewardmd.in

# --- Turn-taking / cost tuning (safe defaults) ---
VOICE_VAD_STOP_SECS=0.35
VOICE_RESUME_SECS=0.4
VOICE_IDLE_TIMEOUT_SECS=30
VOICE_CONVO_MAX_SECONDS=240

# Copy to voice-service/deploy/.env and fill in. This file's values become the RunPod POD env.
# NEVER commit .env (it holds secrets — deploy/.env is gitignored).
#
# --- FollowCare (Cloudflare) ---
FOLLOWCARE_BASE=https://stewardmd.in/api/followcare
FOLLOWCARE_VOICE_SERVICE_TOKEN=CHANGE_ME_long_random_shared_secret
# --- Plivo (from the Plivo dashboard; number configured as "Application", not AI Agents) ---
PLIVO_AUTH_ID=CHANGE_ME
PLIVO_AUTH_TOKEN=CHANGE_ME
PLIVO_FROM=918031906669
# --- Gemini 2.5 Flash (slot extraction only) ---
# Slot extraction reuses the EXISTING shared transport: Vertex AI is PRIMARY (existing GCP_* config on
# Cloudflare); this key is the AI Studio FALLBACK. It is pushed to Cloudflare (cloudflare.sh), NOT to the pod.
GEMINI_API_KEY=CHANGE_ME
# --- Public URL Plivo reaches the pod at. Fill AFTER the pod is up (RunPod proxy URL). ---
VOICE_PUBLIC_BASE=https://CHANGE_ME-8080.proxy.runpod.net
# --- RunPod self-stop (the pod stops its own GPU when the call queue drains) ---
RUNPOD_API_KEY=CHANGE_ME
RUNPOD_POD_ID=SET_AUTOMATICALLY_AFTER_UP
# --- Models / behaviour (defaults are fine) ---
STT_MODEL=ai4bharat/indic-conformer-600m-multilingual
TTS_MODEL=ai4bharat/indic-parler-tts
VOICE_MAX_CONCURRENT=5
VOICE_AUDIO_FORMAT=mulaw
#
# Also set THESE THREE on Cloudflare (Pages project), same values:
#   FOLLOWCARE_VOICE_SERVICE_TOKEN, RUNPOD_API_KEY, RUNPOD_POD_ID
# (run deploy/cloudflare.sh). Cloudflare needs them so the run-voice cron can resume the pod.

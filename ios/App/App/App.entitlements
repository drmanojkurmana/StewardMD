<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple (Apple Guideline 4.8, required because Google sign-in is offered).
	     Enable the matching capability in Xcode ▸ Signing & Capabilities and in your Apple
	     Developer App ID; Xcode will keep this file in sync with the provisioning profile. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- NOTE: aps-environment (push) was removed for now so automatic signing succeeds with
	     only the Sign in with Apple capability. Re-add it (and enable Push Notifications on the
	     App ID + Xcode capability) when APNs is configured, or signing will fail to provision. -->
</dict>
</plist>

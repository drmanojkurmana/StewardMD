<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>StewardMD</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.911280405587-3bdako2v5bi864qqlv3nhpubsjel62q7</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>in.stewardmd.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>stewardmd</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>StewardMD uses the camera so you can capture a monitor, ventilator, or medication photo for AI-assisted reading of values. Photos are processed for the analysis you request and are not stored on our servers.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>StewardMD uses Face ID to unlock the app on this device, if you choose that instead of a PIN. No biometric data leaves your device.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>StewardMD uses the microphone for MaiK Scribe voice intake so you can dictate a patient’s vitals, labs, or clinical findings. Speech is transcribed on your device; only the resulting text is used.</string>
	<key>NSMotionUsageDescription</key>
	<string>StewardMD uses device motion so FundX can sense how the phone is tilted and guide you to level and rotate it while capturing a retinal image. Motion data stays on your device.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>StewardMD may save an image (e.g. a captured monitor photo or exported case) to your photo library when you choose to.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>StewardMD lets you pick an existing photo (e.g. a monitor or lab image) for AI-assisted reading of values. The image is processed for the analysis you request and is not stored on our servers.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>StewardMD uses on-device speech recognition to turn your dictation into text for MaiK Scribe. Audio stays on your device so only the transcribed text is used, and you review it before anything is applied.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Home Screen quick actions (long-press the icon). Delivered to SceneDelegate, NOT to
	     application(_:performActionFor:) - this app uses UIApplicationSceneManifest, so the
	     pre-scene callback is never called and items declared here would silently do nothing.
	     Each type is mapped to an existing stewardmd:// route in SceneDelegate.route(for:).

	     ORDER IS DELIBERATE. Rapido puts its retention row first because a ride app is opened
	     rarely. StewardMD is a work tool opened many times a shift, so the three clinical actions
	     come first and the feedback row sits last, where it is still seen on the way to Delete App
	     but never costs a doctor a tap during a round. iOS shows at most four. -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>in.stewardmd.shortcut.askmaik</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Ask MaiK</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Dose, interaction, guideline</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>sparkles</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>in.stewardmd.shortcut.drugs</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Drug lookup</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Works without a signal</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>pills.fill</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>in.stewardmd.shortcut.icu</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>ICU dashboard</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Vitals, labs, drips</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>waveform.path.ecg</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>in.stewardmd.shortcut.feedback</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>🥺 Before you delete us</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Tell us what went wrong, we will fix it</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>heart.text.square.fill</string>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIStatusBarStyle</key>
	<string></string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>

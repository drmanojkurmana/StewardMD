# Cloudflare Worker tooling / caches (never commit)
.wrangler/
worker/.wrangler/
worker/node_modules/
node_modules/
**/.dev.vars

# Large drug-database source files — NEVER commit (exceed GitHub's 100 MB limit;
# imported into Cloudflare D1, not shipped via the repo)
stewardmd_drug_database.*
*.sqlite
*.sqlite3

# OS noise
.DS_Store

# ── Capacitor (native app wrapper) ───────────────────────────────────────────
# Generated web bundle (rebuild with `npm run build:www`) and the copies Capacitor
# syncs into the native projects.
/www/
/ios/App/App/public/
/android/app/src/main/assets/public/
# Generated per-sync config copies
/ios/App/App/capacitor.config.json
/android/app/src/main/assets/capacitor.config.json
# iOS build artifacts (project scaffold IS committed; build output is not)
/ios/App/Pods/
/ios/App/build/
/ios/DerivedData/
# SPM symlinks regenerated by `cap sync` (Package.swift references them; recreated on every sync)
/ios/App/CapApp-SPM/symlinks/
*.xcuserstate
xcuserdata/
# Android build artifacts (project scaffold IS committed; build output is not)
/android/.gradle/
/android/build/
/android/app/build/
/android/app/release/
/android/capacitor-cordova-android-plugins/build/
/android/local.properties
.idea/
*.iml
# Signing material + per-project service config — NEVER commit (add locally)
*.keystore
*.jks
google-services.json
GoogleService-Info.plist

# Local Claude Code session/agent state
.claude/

# Offline-clinical build artifacts (only the .gz ships; JSON + temp DB are regenerated)
data/offline-clinical.json
data/.clinical-build.db

# KB search index — a BUILD ARTIFACT (generated by `node kb/tools/build-kb-index.mjs`, consumed only
# by the embed/AI Node tools + tests; never fetched at runtime, excluded from the app bundle). It grew
# past Cloudflare Pages' 25 MiB per-file limit, which silently FAILED every production deploy. Keep it
# out of git; regenerate locally/CI when embedding. See docs/ICU_OVERDUE_PUSH.md / build-kb-index.mjs.
kb/dist/kb.index.json

# local Capacitor plugin build output (source is tracked; build dirs are not)
local-plugins/**/build/

# management-generation intermediates (sidecars + batch inputs); the content is
# merged into kb/reference/*.json by kb/tools/mgmt/apply.mjs, which IS tracked.
kb/_mgmt/

# large model artifact — baked into the Cloud Run container, not for Pages deploy
backend/kardiox-image/image_model.pt

# python build artifacts
__pycache__/
*.pyc

# ThoreX on-device model binaries served to the local browser harness — a
# copy of backend/thorex/models/thorex_clinical.onnx, regenerate with
# backend/thorex/scripts/export_clinical_onnx.py. The labels JSON IS committed.
models/*.onnx

# ThoreX local dev harness + dormant module — never ship (localhost auth-bypass stubs).
thorex-demo.html
thorex-deid.js
backend/kardiox-pdf/1_lead_ECGFounder.pth
*service-account*.json
play-*.json
play-api-*.json
*-play-key*.json
# Play Developer API service-account keys — NEVER commit (keep outside the repo)
backend/kardiox-image/image_model_mireal.pt
backend/kardiox-image/image_model_v2.pt

# RadioAnatome pipeline: volumes, masks, venvs and the vendored SynthSeg clone are
# regenerated locally, never committed
atlas-pipeline/work/
# No trailing slash as well: the slash form matches a DIRECTORY only, so a symlink
# named work/ slipped past it and got committed (mode 120000, absolute path). Pages
# then failed the build with "contains links to files that can't be accessed" and a
# whole commit never reached production.
atlas-pipeline/work
atlas-pipeline/.venv/
atlas-pipeline/.venv-ss/
atlas-pipeline/synthseg-repo/
*.nii
*.nii.gz

# SwiftPM build output for the local Capacitor plugins (429MB, contains dSYMs >100MB).
# Never commit: GitHub hard-rejects files over 100MB and this is pure build artifact.
local-plugins/*/.build/
# Android CMake/NDK build output for the local plugins (230MB; libllama.a alone is 93MB).
# capacitor-whisper already avoids committing this - match it.
local-plugins/*/android/.cxx/
local-plugins/*/android/build/

# Debug/scratch output that is NOT source. Both were swept into a commit by a `git add -A` on
# 2026-08-26 - atlas/_tmp-brain-test/ landed inside atlas/ and failed atlas-checks, which is how it
# was caught. Ignored so the next sweep cannot repeat it.
.playwright-mcp/
atlas/_tmp-brain-test/
ios/DerivedDataRelease/
data/govschemes/extracted/

# TASK 8.10: real-model evaluation run artifacts. Baselines ARE tracked (they are the
# regression reference); per-run results are not - they carry model output and change every run.
test/wardsynq-maik-eval/results.*.json

# wardsynq.com site build output (scripts/build-wardsynq-site.sh)
/dist-wardsynq/

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stewardmd.in/contracts/phase-1/schemas/run-create.request.json",
  "title": "POST /v1/projects/{projectId}/runs request",
  "description": "The API pools server-side by importing research-engine.js. studyVersions pins exact study versions (optimistic-concurrency snapshot); when absent the API pins the current latest verified versions. Any listed study that is unverified, missing, or version-stale fails the whole run (see 422 and 409 codes in errors.md) and nothing is saved.",
  "type": "object",
  "required": ["measure"],
  "additionalProperties": false,
  "properties": {
    "measure": { "type": "string", "enum": ["OR", "RR", "HR", "RD", "MD", "SMD"] },
    "model": { "type": "string", "enum": ["fixed", "random_dl", "random_reml"], "default": "random_dl" },
    "test": { "type": "string", "enum": ["wald", "knha"], "default": "wald" },
    "level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1, "default": 0.95 },
    "studyVersions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["studyId", "version"],
        "additionalProperties": false,
        "properties": {
          "studyId": { "type": "string" },
          "version": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stewardmd.in/contracts/phase-3/extraction-templates.response.json",
  "title": "GET /v1/extraction-templates response",
  "type": "object",
  "required": ["templates"],
  "additionalProperties": false,
  "properties": {
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "fields", "measures"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "enum": ["rct_binary", "rct_continuous", "generic_effect"] },
          "label": { "type": "string" },
          "measures": { "type": "array", "items": { "type": "string", "enum": ["OR", "RR", "HR", "RD", "MD", "SMD"] } },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "label", "type", "required"],
              "additionalProperties": false,
              "properties": {
                "key": { "type": "string" },
                "label": { "type": "string" },
                "type": { "type": "string", "enum": ["integer", "number", "text"] },
                "required": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stewardmd.in/contracts/phase-3/extraction-audit.response.json",
  "title": "GET /v1/extractions/{extractionId}/audit response",
  "type": "object",
  "required": ["events"],
  "additionalProperties": false,
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "by", "ts"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "enum": ["field_saved", "verified", "corrected", "suggestion_accepted", "promoted"] },
          "fieldKey": { "type": "string" },
          "old": { "type": ["string", "number", "null"] },
          "new": { "type": ["string", "number", "null"] },
          "reason": { "type": "string" },
          "by": { "type": "string" },
          "ts": { "type": "integer" }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stewardmd.in/contracts/phase-3/rob-assessment.schema.json",
  "title": "ResearchMD risk-of-bias assessment (blinded dual)",
  "type": "object",
  "required": ["tool", "outcome"],
  "additionalProperties": false,
  "properties": {
    "studyId": { "type": "string" },
    "tool": { "type": "string", "enum": ["rob2", "robins_i", "quadas2", "nos"] },
    "outcome": { "type": "string", "enum": ["pending", "agreed", "conflict"] },
    "conflictId": { "type": ["string", "null"] },
    "self": { "$ref": "#/definitions/assessor" },
    "peer": {
      "oneOf": [
        { "type": "object", "required": ["hidden"], "additionalProperties": false, "properties": { "hidden": { "const": true } } },
        { "$ref": "#/definitions/assessor" }
      ]
    },
    "consensus": { "$ref": "#/definitions/assessor" }
  },
  "definitions": {
    "assessor": {
      "type": "object",
      "required": ["submitted", "domains"],
      "additionalProperties": false,
      "properties": {
        "submitted": { "type": "boolean" },
        "overall": { "type": ["string", "null"] },
        "stars": { "type": "integer" },
        "domains": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "judgment"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string" },
              "judgment": { "type": "string" },
              "quote": { "type": "string" },
              "locator": { "oneOf": [{ "$ref": "../phase-1/locator.schema.json" }, { "type": "null" }] },
              "applicability": { "type": "string" },
              "stars": { "type": "integer" },
              "signallingAnswers": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}

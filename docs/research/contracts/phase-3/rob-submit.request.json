{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stewardmd.in/contracts/phase-3/rob-submit.request.json",
  "title": "POST /v1/projects/{projectId}/studies/{studyId}/rob request",
  "type": "object",
  "required": ["tool", "domains"],
  "additionalProperties": false,
  "properties": {
    "tool": { "type": "string", "enum": ["rob2", "robins_i", "quadas2", "nos"] },
    "version": { "type": "integer" },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "judgment", "quote", "locator"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "judgment": { "type": "string" },
          "quote": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "locator": { "$ref": "../phase-1/locator.schema.json" },
          "applicability": { "type": "string" },
          "stars": { "type": "integer" },
          "signallingAnswers": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    }
  }
}

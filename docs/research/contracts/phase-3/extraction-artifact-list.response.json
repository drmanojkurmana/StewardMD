{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stewardmd.in/contracts/phase-3/extraction-artifact-list.response.json",
  "title": "GET /v1/projects/{projectId}/artifacts response",
  "type": "object",
  "required": ["artifacts"],
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "projectId", "filename", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "projectId": { "type": "string" },
          "filename": { "type": "string" },
          "sha256": { "type": "string" },
          "bytes": { "type": "integer" },
          "pages": { "type": "integer" },
          "status": { "type": "string", "enum": ["queued", "running", "succeeded", "failed", "cancelled"] },
          "jobId": { "type": ["string", "null"] },
          "createdTs": { "type": "integer" }
        }
      }
    }
  }
}

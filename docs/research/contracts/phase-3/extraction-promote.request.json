{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stewardmd.in/contracts/phase-3/extraction-promote.request.json",
  "title": "POST /v1/extractions/{extractionId}/promote request",
  "type": "object",
  "required": ["measure"],
  "additionalProperties": false,
  "properties": {
    "measure": { "type": "string", "enum": ["OR", "RR", "HR", "RD", "MD", "SMD"] },
    "label": { "type": "string", "maxLength": 240 },
    "locatorFieldKey": { "type": "string", "description": "Field whose locator+quote become the study locator; default first verified field." }
  }
}

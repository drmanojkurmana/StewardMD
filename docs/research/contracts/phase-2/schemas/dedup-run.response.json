{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stewardmd.in/contracts/phase-2/schemas/dedup-run.response.json",
  "title": "POST /v1/projects/{projectId}/dedup:run response",
  "description": "The dedup outcome. duplicatesRemoved counts non-canonical members; nothing is deleted, so PRISMA can still account for every identified record.",
  "type": "object",
  "required": ["dedupRun"],
  "additionalProperties": false,
  "properties": {
    "dedupRun": {
      "type": "object",
      "required": ["groupsCreated", "duplicatesRemoved", "groupIds"],
      "additionalProperties": false,
      "properties": {
        "groupsCreated": { "type": "integer", "minimum": 0 },
        "duplicatesRemoved": { "type": "integer", "minimum": 0 },
        "groupIds": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

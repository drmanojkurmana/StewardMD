{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stewardmd.in/contracts/phase-2/schemas/import-create.response.json",
  "title": "POST /v1/projects/{projectId}/imports response",
  "description": "The import outcome. recordsAdded counts new record rows; duplicatesFlagged counts entries merged into existing dedup groups (never silently dropped). searchRunId is the database=import run for replay.",
  "type": "object",
  "required": ["import"],
  "additionalProperties": false,
  "properties": {
    "import": {
      "type": "object",
      "required": ["searchRunId", "recordsAdded", "duplicatesFlagged", "groupIds"],
      "additionalProperties": false,
      "properties": {
        "searchRunId": { "type": "string" },
        "recordsAdded": { "type": "integer", "minimum": 0 },
        "duplicatesFlagged": { "type": "integer", "minimum": 0 },
        "groupIds": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

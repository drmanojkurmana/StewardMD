{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stewardmd.in/contracts/phase-2/schemas/conflict-list.response.json",
  "title": "GET /v1/projects/{projectId}/conflicts response",
  "description": "Conflicts, open first then newest. Exactly one of recordId/reportId is set. resolution fields appear only when status is resolved.",
  "type": "object",
  "required": ["conflicts"],
  "additionalProperties": false,
  "properties": {
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "projectId", "stage", "status", "createdTs"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "projectId": { "type": "string" },
          "recordId": { "type": "string" },
          "reportId": { "type": "string" },
          "stage": { "type": "string", "enum": ["title_abstract", "full_text"] },
          "status": { "type": "string", "enum": ["open", "resolved"] },
          "resolution": { "type": "string", "enum": ["include", "exclude"] },
          "resolutionReason": { "type": "string" },
          "resolvedBy": { "type": "string" },
          "resolvedTs": { "type": "integer", "minimum": 0 },
          "createdTs": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "nextCursor": { "type": "string" }
  }
}

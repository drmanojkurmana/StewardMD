{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stewardmd.in/contracts/phase-2/schemas/dedup-group-list.response.json",
  "title": "GET /v1/projects/{projectId}/dedup-groups response",
  "description": "Dedup groups, newest first. memberIds always includes the canonical record.",
  "type": "object",
  "required": ["groups"],
  "additionalProperties": false,
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "projectId", "canonicalRecordId", "memberIds", "algorithm", "createdTs"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "projectId": { "type": "string" },
          "canonicalRecordId": { "type": "string" },
          "memberIds": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "algorithm": { "type": "string" },
          "createdTs": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "nextCursor": { "type": "string" }
  }
}

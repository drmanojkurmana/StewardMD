rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's saved cases are PRIVATE to that user. (Previously this allowed any
    // signed-in user to read/write ANY user's cases — broken access control / PHI IDOR.)
    match /users/{userId}/cases/{caseId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // StewardMD shareable case codes: signed-in users create; anyone may read by code,
    // but ONLY while unexpired (expiry is now enforced server-side, not just in the UI).
    match /sharedCases/{code} {
      allow read: if resource.data.expiresAt is number
                  && resource.data.expiresAt > request.time.toMillis();
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.expiresAt is number
                    // cap the TTL so shares can't be made effectively permanent (~32 days max)
                    && request.resource.data.expiresAt <= request.time.toMillis() + 32 * 24 * 60 * 60 * 1000
                    // bound the public payload size (defense against abuse / large dumps)
                    && (!('html' in request.resource.data) || request.resource.data.html.size() < 100000);
      allow update, delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

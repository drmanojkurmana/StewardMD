    { "id": "rf_sepsis", "label": "Low blood pressure, confusion or fast breathing (possible sepsis)", "type": "check" },
    { "id": "rf_hyperkalaemia", "label": "Hyperkalaemia symptoms: muscle weakness, palpitations or irregular pulse, or a high potassium result", "type": "check" },
    { "id": "rf_fluid_overload", "label": "Breathless at rest, crackles or pulmonary oedema (fluid overload)", "type": "check" },
    { "id": "rf_uraemic", "label": "Drowsiness, confusion, fits or pericardial rub (severe uraemia)", "type": "check" },
    { "id": "rf_clot_retention", "label": "Heavy visible haematuria or clot retention", "type": "check" },
    { "id": "rf_single_kidney", "label": "Obstruction of a single kidney or both kidneys", "type": "check" },
    { "id": "rf_pd_peritonitis", "label": "Cloudy PD fluid or abdominal pain on PD (possible peritonitis)", "type": "check" },
    { "id": "rf_access", "label": "Bleeding from dialysis access, or fistula thrill lost", "type": "check" },
    { "id": "rf_torsion", "label": "Sudden severe testicular pain (possible torsion)", "type": "check" }

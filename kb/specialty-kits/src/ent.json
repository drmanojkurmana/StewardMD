 "advice": [
  {
   "id": "ear-care",
   "title": "Caring for your ears",
   "target": "diet_lifestyle_advice",
   "text": "Do not put cotton buds, hairpins, oil or home remedies into the ears; wax usually comes out by itself. Keep dirty water out of the ears when bathing or swimming. See a doctor soon for ear pain, discharge, bleeding or hearing loss, and on the same day if hearing is lost suddenly."
  },
  {
   "id": "safe-listening",
   "title": "Protecting your hearing",
   "target": "diet_lifestyle_advice",
   "text": "Keep phone and earphone volume below 60% of maximum, limit listening time and take breaks from loud sound. Use ear plugs or ear muffs in noisy work and at loud events, and keep away from loudspeakers."
  },
  {
   "id": "nosebleed-first-aid",
   "title": "Nosebleed first aid",
   "target": "follow_up_advice",
   "text": "If your nose bleeds, stay calm, sit up and lean forward, and pinch the soft part of the nose firmly for 15 minutes without letting go, breathing through your mouth. Avoid picking the nose or blowing it hard, and keep the inside moist with saline spray or gel. Do not stop a blood thinner without asking the doctor who prescribed it. Go to the emergency department if bleeding is heavy or has not stopped after 15 minutes of pinching, or if you feel weak or faint."
  },
  {
   "id": "tobacco-warning-signs",
   "title": "Tobacco and warning signs",
   "target": "diet_lifestyle_advice",
   "text": "Stop all forms of tobacco, including cigarettes, bidis, gutkha, khaini and tobacco paan, stop chewing areca nut (supari), and cut down alcohol. See a doctor if a mouth ulcer has not healed in 3 weeks, or if you notice a red or white patch in the mouth, a lump in the neck, or a hoarse voice that does not go away."
  }
 ],

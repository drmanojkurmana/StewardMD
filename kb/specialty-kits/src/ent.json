  {
   "id": "ent-red-flags",
   "title": "Red flags",
   "target": "History_present_illness",
   "alert": "Stridor or drooling is an airway emergency: get senior airway help at once and do not force a throat examination. Deep neck infection, sudden hearing loss, new facial palsy, mastoid swelling or suspected mucormycosis need same-day ENT assessment; a persistent neck lump, hoarseness or oral ulcer needs urgent referral (within 2 weeks) to exclude cancer.",
   "fields": [
    { "id": "rf_stridor", "label": "Stridor, drooling or difficulty breathing", "type": "check" },
    { "id": "rf_deep_neck_infection", "label": "Trismus, unable to swallow saliva, or neck swelling with fever", "type": "check" },
    { "id": "rf_neck_lump", "label": "Unilateral neck lump for over 3 weeks", "type": "check" },
    { "id": "rf_hoarseness", "label": "Hoarseness for over 3 weeks in a smoker or tobacco user", "type": "check" },
    { "id": "rf_oral_ulcer", "label": "Mouth ulcer for over 3 weeks, or a red or red and white patch", "type": "check" },
    { "id": "rf_facial_palsy", "label": "Facial palsy", "type": "check" },
    { "id": "rf_mastoid", "label": "Swelling, redness or tenderness behind the ear", "type": "check" },
    { "id": "rf_sudden_hearing_loss", "label": "Sudden hearing loss (over 3 days or less) in the past 30 days", "type": "check" },
    { "id": "rf_mucormycosis", "label": "Black nasal crusts, palatal discolouration or facial numbness (possible mucormycosis)", "type": "check" }

 "advice": [
  {
   "id": "falls-prevention",
   "title": "Preventing falls",
   "target": "diet_lifestyle_advice",
   "text": "Do the balance and strength exercises you have been shown, regularly. Keep floors clear and dry, use a night light, fit grab rails near the toilet and bath, and wear well-fitting shoes with a firm sole. Get up slowly from lying or sitting. Have your eyes checked, and bring all your medicines, including herbal ones, to every visit."
  },
  {
   "id": "after-a-fall",
   "title": "After a fall",
   "target": "follow_up_advice",
   "text": "If you fall and hit your head while taking a blood thinner, come to hospital the same day even if you feel well. Come at once for new confusion, drowsiness, severe headache or vomiting, or if you cannot stand or walk after a fall. Keep a phone within reach and tell your family how to help you."
  },
  {
   "id": "sudden-confusion",
   "title": "Sudden confusion: advice for family",
   "target": "follow_up_advice",
   "text": "If your relative suddenly becomes confused, very sleepy, restless or not their usual self over hours or days, bring them to hospital the same day. This can be a sign of infection, dehydration or a medicine side effect, and it can often be treated."
  }
 ],

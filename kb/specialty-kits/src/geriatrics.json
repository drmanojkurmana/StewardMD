  {
   "id": "red-flags",
   "title": "Red flags",
   "target": "History_present_illness",
   "alert": "Red flag present. Acute confusion: assess with the 4AT and look for the cause today (infection, medicines, urinary retention, constipation, dehydration, pain); do not assume it is dementia. Head injury on an anticoagulant or antiplatelet: CT head within 8 hours of the injury. Possible hip fracture, or a fall with blackout, chest pain or palpitations: same-day emergency assessment.",
   "fields": [
    { "id": "rf_delirium", "label": "Acute confusion, drowsiness or change in behaviour over hours to days (possible delirium)", "type": "check" },
    { "id": "rf_head_injury_anticoag", "label": "Fall with head injury while taking an anticoagulant or antiplatelet (other than aspirin alone)", "type": "check" },
    { "id": "rf_hip", "label": "Fall with hip or groin pain, or unable to bear weight (possible hip fracture)", "type": "check" },
    { "id": "rf_syncope", "label": "Fall with blackout, chest pain or palpitations", "type": "check" }

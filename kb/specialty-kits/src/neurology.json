 "advice": [
  {
   "id": "stroke-warning-signs",
   "title": "Stroke warning signs",
   "target": "follow_up_advice",
   "text": "Call an ambulance or come to hospital at once if you or someone with you suddenly gets weakness or numbness of the face, arm or leg, difficulty speaking or understanding, loss of vision, or loss of balance. Note the time it started. Do not wait to see if it gets better: treatment works best in the first few hours."
  },
  {
   "id": "seizure-safety",
   "title": "Living safely with seizures",
   "target": "diet_lifestyle_advice",
   "text": "Do not drive until your doctor tells you it is safe and the law allows it. Bathe with a bucket and mug or a shower rather than in a bathtub, never bathe or swim alone in a river, pond or pool, avoid working at heights, and take care when cooking. Take your seizure medicines every day and do not stop them suddenly. Sleep well and avoid alcohol binges."
  },
  {
   "id": "seizure-first-aid",
   "title": "First aid for a seizure (for family)",
   "target": "follow_up_advice",
   "text": "Stay calm, move hard objects away and cushion the head. Do not put anything in the mouth or hold the person down. When the jerking stops, turn them on their side. Time the seizure, and call an ambulance if it lasts 5 minutes or more, another seizure follows, they are injured, or breathing is difficult."
  },
  {
   "id": "headache-warning",
   "title": "Headache: when to come at once",
   "target": "follow_up_advice",
   "text": "Come to hospital at once for a sudden, very severe headache (the worst you have ever had), a headache with fever and a stiff neck, or a headache after a head injury. Also come at once for fits, confusion, trouble speaking, or weakness or numbness of one side of the body, with or without a headache. Keep a headache diary, and avoid taking painkillers on many days each month, as this can make headaches worse."
  }
 ],

 "advice": [
  {
   "id": "eye-danger-signs",
   "title": "When to come back at once",
   "target": "follow_up_advice",
   "text": "Come back the same day if your sight gets worse, the eye becomes more painful or red, light starts to hurt your eyes, or you notice new floaters, flashes of light or a shadow spreading across your vision. Any sudden loss of sight needs to be seen the same day, even if it recovers."
  },
  {
   "id": "red-eye-hygiene",
   "title": "Red eye: stopping the spread",
   "target": "diet_lifestyle_advice",
   "text": "Wash your hands often, use your own towel and pillow, and avoid close contact with others for 10 to 14 days while the eye is red and watery. Do not put steroid drops, leftover drops or home remedies in the eye unless your eye doctor has advised them."
  },
  {
   "id": "diabetes-eye-check",
   "title": "Diabetes and your eyes",
   "target": "follow_up_advice",
   "text": "If you have diabetes, have a dilated eye examination at least once a year, even when you see well, because early damage gives no symptoms and early treatment works best. Keeping blood sugar and blood pressure under control lowers the risk of losing sight."
  },
  {
   "id": "eye-protection",
   "title": "Protecting your eyes",
   "target": "diet_lifestyle_advice",
   "text": "Wear protective glasses for farm work, grinding, welding and sport, and keep children away from firecrackers. Stopping smoking lowers the risk of cataract and macular disease. Have eye problems checked by a trained eye doctor rather than using remedies from untrained providers."
  }
 ],

 "advice": [
  {
   "id": "head-injury-warning-signs",
   "title": "After a head injury: when to come back at once",
   "target": "follow_up_advice",
   "text": "Come back at once or call an ambulance if the person cannot stay awake, has a fit, has problems with vision, hearing, walking, balance, speaking or understanding, has new numbness or weakness, has clear fluid coming from the ears or nose or bleeding from the ears, or their behaviour changes. Also get help if they keep vomiting or feel dizzy. An adult should stay with them for the first 24 hours, and they should rest and not drink alcohol until better."
  },
  {
   "id": "sepsis-warning-signs",
   "title": "Signs of serious infection (sepsis)",
   "target": "follow_up_advice",
   "text": "Come to hospital at once if you are breathing very fast, become confused or have slurred speech, have blue, pale or blotchy skin, have a rash that does not fade when you press it, or feel very hot or very cold and shivery."
  }
 ],

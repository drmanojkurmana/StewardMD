 "advice": [
  {
   "id": "hernia-warning-signs",
   "title": "Hernia: when to come to hospital at once",
   "target": "follow_up_advice",
   "text": "Come to hospital at once if you get pain in or around the hernia, your tummy swells, you feel sick or vomit, you cannot open your bowels, you feel hot, cold or shivery, or you become confused. Until the hernia is repaired, keep to a healthy weight, stay active, stop smoking, and see a doctor for a cough that does not settle."
  },
  {
   "id": "wound-care",
   "title": "Caring for your wound",
   "target": "follow_up_advice",
   "text": "Keep the wound clean and dry and follow the dressing advice you were given. Come back if the wound becomes more painful, red, hot or swollen, leaks pus or fluid, opens up or smells bad, or if you get a fever or feel unwell."
  },
  {
   "id": "breast-after-tests",
   "title": "After your breast tests",
   "target": "follow_up_advice",
   "text": "If your breast tests are normal but you are still worried, or you notice a new change in the breast, nipple or armpit, see your doctor again."
  }
 ],

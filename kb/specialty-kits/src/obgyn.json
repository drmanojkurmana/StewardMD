 "advice": [
  {
   "id": "antenatal-danger-signs",
   "title": "Antenatal danger signs",
   "target": "follow_up_advice",
   "text": "Come to hospital at once if you have bleeding from the vagina, leaking of water, severe headache or blurred vision, fits, swelling of the face or hands, severe abdominal pain, fever, difficulty breathing, or if the baby moves less than usual."
  },
  {
   "id": "antenatal-nutrition",
   "title": "Diet and supplements in pregnancy",
   "target": "diet_lifestyle_advice",
   "text": "Eat an extra meal each day with pulses, green leafy vegetables, fruit and milk. Take the iron-folic acid and calcium tablets exactly as prescribed, not at the same time. Do not use tobacco or alcohol."
  },
  {
   "id": "postnatal-danger-signs",
   "title": "Danger signs after delivery",
   "target": "follow_up_advice",
   "text": "Come back at once for heavy bleeding, fever, foul-smelling discharge, severe headache, fits, breathlessness, pain or swelling in one leg, or a painful red breast."
  }
 ],

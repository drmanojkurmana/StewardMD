 "advice": [
  {
   "id": "drug-reaction-warning",
   "title": "Serious drug reaction: warning signs",
   "target": "follow_up_advice",
   "text": "Come to hospital at once if you get fever with a sore throat or sore red eyes, a painful red or purple rash, blisters or peeling skin, or sores in the mouth, eyes or genitals. If a medicine caused your skin reaction, keep a record of its name, tell every doctor and pharmacist, and do not start any new medicine, even one bought without a prescription, before asking your doctor."
  },
  {
   "id": "leprosy-care",
   "title": "Leprosy: treatment and self-care",
   "target": "follow_up_advice",
   "text": "Leprosy is curable. Take the multidrug treatment regularly until the full course is finished. If your hands or feet are numb, check them every day for cuts, burns, blisters or red spots, soak dry skin in water and then apply oil or moisturiser, and wear footwear with a soft inner sole. Come back at once if patches become red and swollen, or you get nerve pain, new numbness or weakness, painful lumps with fever, or red eyes."
  },
  {
   "id": "ringworm-care",
   "title": "Fungal skin infection (ringworm)",
   "target": "diet_lifestyle_advice",
   "text": "Use the antifungal medicine regularly and continue it as advised, usually for 2 weeks after the rash clears. Do not apply steroid or mixed creams bought without a prescription. Wear loose clothes and change them when sweaty, do not share towels, bed linen or clothes, wash undergarments and socks often and dry them in the sun, and get family members with a similar rash examined."
  },
  {
   "id": "scabies-care",
   "title": "Scabies: treat everyone together",
   "target": "follow_up_advice",
   "text": "Everyone in the household and other close contacts must be treated at the same time, even if they do not itch. Wash clothes, towels and bed linen when you start treatment, and seal anything that cannot be washed in a bag for 3 days. Itching often carries on for a few weeks after the mites are killed."
  }
 ],

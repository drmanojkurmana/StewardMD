 "advice": [
  {
   "id": "falls-in-hospital",
   "title": "Preventing falls in hospital",
   "target": "follow_up_advice",
   "text": "Call the nurse before getting out of bed or going to the toilet if you feel weak or dizzy. Keep the call bell and water within reach, wear non-slip slippers or your own shoes, and keep the room clear of clutter."
  },
  {
   "id": "drip-site",
   "title": "Your drip (cannula)",
   "target": "follow_up_advice",
   "text": "Tell the nurse at once if the skin around the drip becomes painful, red, swollen or hard, if you feel a cord along the vein, or if you get a fever. Do not remove or adjust the drip yourself."
  },
  {
   "id": "eating-in-hospital",
   "title": "Eating and drinking in hospital",
   "target": "diet_lifestyle_advice",
   "text": "Try to eat and drink regularly. Tell the nurse if you cannot finish your meals, have lost weight without trying, or have not been able to eat for several days, so that we can help."
  }
 ],

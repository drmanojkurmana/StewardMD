 "sections": [
  {
   "id": "vital-signs-news2",
   "title": "Vital signs and NEWS2",
   "target": "sys_examination",
   "fields": [
    { "id": "rr", "label": "Respiration rate", "type": "number", "unit": "/min", "set": "respiratory" },
    { "id": "spo2", "label": "SpO2", "type": "number", "unit": "%", "set": "spo2" },
    { "id": "spo2_scale", "label": "SpO2 scale", "type": "select", "opts": ["Scale 1", "Scale 2 (prescribed target 88 to 92%)"], "hint": "Scale 2 only for confirmed hypercapnic respiratory failure, on a clinician's decision" },
    { "id": "air_oxygen", "label": "Air or oxygen", "type": "select", "opts": ["Air", "Oxygen"] },
    { "id": "sbp", "label": "BP systolic", "type": "number", "unit": "mmHg", "set": "BP_SYS" },
    { "id": "dbp", "label": "BP diastolic", "type": "number", "unit": "mmHg", "set": "BP_dia" },
    { "id": "pulse", "label": "Pulse", "type": "number", "unit": "/min", "set": "Pulse" },
    { "id": "acvpu", "label": "Consciousness (ACVPU)", "type": "select", "opts": ["Alert", "New confusion", "Responds to voice", "Responds to pain", "Unresponsive"] },
    { "id": "temp_c", "label": "Temperature", "type": "number", "unit": "°C" },
    { "id": "news2_score", "label": "NEWS2 aggregate score", "type": "number", "hint": "5 or more, or 3 in any single parameter, needs an urgent review" },
    { "id": "pain", "label": "Pain score (0 to 10)", "type": "number", "unit": "/10", "set": "pain_score" },
    { "id": "cbg", "label": "Capillary blood glucose", "type": "number", "unit": "mg/dL", "set": "grbs" }
   ]
  },
  {
   "id": "pressure-skin",
   "title": "Pressure injury risk (Braden) and skin",
   "target": "skin",
   "fields": [
    { "id": "braden_sensory", "label": "Sensory perception", "type": "select", "opts": ["Completely limited (1)", "Very limited (2)", "Slightly limited (3)", "No impairment (4)"] },
    { "id": "braden_moisture", "label": "Moisture", "type": "select", "opts": ["Constantly moist (1)", "Often moist (2)", "Occasionally moist (3)", "Rarely moist (4)"] },
    { "id": "braden_activity", "label": "Activity", "type": "select", "opts": ["Bedfast (1)", "Chairfast (2)", "Walks occasionally (3)", "Walks frequently (4)"] },
    { "id": "braden_mobility", "label": "Mobility", "type": "select", "opts": ["Completely immobile (1)", "Very limited (2)", "Slightly limited (3)", "No limitations (4)"] },
    { "id": "braden_nutrition", "label": "Nutrition", "type": "select", "opts": ["Very poor (1)", "Probably inadequate (2)", "Adequate (3)", "Excellent (4)"] },
    { "id": "braden_friction", "label": "Friction and shear", "type": "select", "opts": ["Problem (1)", "Potential problem (2)", "No apparent problem (3)"] },
    { "id": "braden_total", "label": "Braden score", "type": "number", "unit": "/23", "hint": "15 to 18 mild, 13 to 14 moderate, 10 to 12 high, 9 or less severe risk" },
    { "id": "skin_inspection", "label": "Skin inspection", "type": "select", "opts": ["Intact", "Redness that blanches", "Non-blanching redness", "Blister or broken skin", "Pressure ulcer or wound", "Moisture damage"] },
    { "id": "skin_details", "label": "Site and details", "type": "text", "hint": "e.g. sacrum 3 x 2 cm non-blanching redness; heels intact" }
   ]
  },
  {
   "id": "falls-mobility",
   "title": "Falls risk (Morse) and mobility",
   "target": "musculo_skeletal_system",
   "fields": [
    { "id": "morse_history", "label": "History of falling", "type": "select", "opts": ["No (0)", "Yes (25)"] },
    { "id": "morse_secondary", "label": "Secondary diagnosis", "type": "select", "opts": ["No (0)", "Yes (15)"] },
    { "id": "morse_aid", "label": "Ambulatory aid", "type": "select", "opts": ["None, bed rest or nurse assist (0)", "Crutches, cane or walker (15)", "Furniture (30)"] },
    { "id": "morse_iv", "label": "IV or IV access", "type": "select", "opts": ["No (0)", "Yes (20)"] },
    { "id": "morse_gait", "label": "Gait", "type": "select", "opts": ["Normal, bed rest or wheelchair (0)", "Weak (10)", "Impaired (20)"] },
    { "id": "morse_mental", "label": "Mental status", "type": "select", "opts": ["Knows own limits (0)", "Overestimates or forgets limits (15)"] },
    { "id": "morse_total", "label": "Morse fall score", "type": "number", "unit": "/125", "hint": "Repeat at a change of condition, transfer to a new unit and after a fall" },
    { "id": "mobility", "label": "Mobility", "type": "select", "opts": ["Independent", "Needs help of one", "Needs help of two or a hoist", "Bedbound"] },
    { "id": "falls_measures", "label": "Falls precautions in place", "type": "text", "hint": "e.g. bed low, call bell and water in reach, non-slip footwear" }

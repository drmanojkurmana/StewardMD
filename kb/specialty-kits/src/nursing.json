    { "id": "must_total", "label": "MUST score", "type": "number" },
    { "id": "must_risk", "label": "Risk of malnutrition", "type": "select", "opts": ["Low (0)", "Medium (1)", "High (2 or more)"] },
    { "id": "must_diet", "label": "Diet and intake", "type": "text", "hint": "e.g. soft diet, eating half of meals, nil by mouth since" },
    { "id": "must_dietitian", "label": "Referred to dietitian or nutrition team", "type": "check" }

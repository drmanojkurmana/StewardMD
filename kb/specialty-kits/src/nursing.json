    { "id": "must_bmi", "label": "BMI score", "type": "select", "opts": ["BMI over 20 (0)", "BMI 18.5 to 20 (1)", "BMI under 18.5 (2)"] },
    { "id": "must_weight_loss", "label": "Unplanned weight loss in past 3 to 6 months", "type": "select", "opts": ["Under 5% (0)", "5 to 10% (1)", "Over 10% (2)"] },

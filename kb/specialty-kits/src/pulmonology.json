  {
   "id": "respiratory-red-flags",
   "title": "Respiratory red flags",
   "target": "History_present_illness",
   "alert": "Respiratory red flag. SpO2 below 92%, a silent chest, cyanosis, exhaustion or drowsiness: give oxygen, start emergency treatment and arrange emergency admission; in acute asthma these are life-threatening. Haemoptysis: chest X-ray and sputum NAAT for TB today; follow the massive haemoptysis protocol if bleeding is large.",
   "fields": [
    { "id": "rf_spo2", "label": "SpO2 below 92% on room air", "type": "check" },
    { "id": "rf_haemoptysis", "label": "Haemoptysis", "type": "check" },
    { "id": "rf_silent_chest", "label": "Silent chest or feeble respiratory effort", "type": "check" },
    { "id": "rf_sentences", "label": "Cannot complete sentences in one breath", "type": "check" },
    { "id": "rf_drowsy", "label": "Drowsy, confused or exhausted", "type": "check" },
    { "id": "rf_cyanosis", "label": "Central cyanosis", "type": "check" },
    { "id": "rf_rr", "label": "Respiratory rate over 30/min", "type": "check" },
    { "id": "rf_pleuritic", "label": "Sudden breathlessness with pleuritic chest pain", "type": "check" }

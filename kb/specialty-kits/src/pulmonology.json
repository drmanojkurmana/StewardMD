 "advice": [
  {
   "id": "inhaler-use",
   "title": "Using your inhaler",
   "target": "diet_lifestyle_advice",
   "text": "Use your inhaler the way you were shown today. Breathe out fully first, seal your lips around the mouthpiece or spacer, breathe in as taught and hold your breath for a few seconds. Use a spacer with a spray inhaler if you were given one, and rinse your mouth after a preventer inhaler. Bring all your inhalers to every visit so we can check how you use them."
  },
  {
   "id": "breathing-danger-signs",
   "title": "Breathing danger signs",
   "target": "follow_up_advice",
   "text": "Come to hospital at once if you are too breathless to speak in full sentences, your lips or fingers turn blue, you feel drowsy or confused, your reliever inhaler is not helping, or you cough up blood."
  },
  {
   "id": "smoke-and-air",
   "title": "Smoke, air and vaccines",
   "target": "diet_lifestyle_advice",
   "text": "Stop smoking cigarettes, beedis and hookah, and ask us for help to quit. Avoid smoke from wood, dung or crop fires used for cooking: use LPG or another clean fuel if you can, and keep the kitchen well ventilated. Take the vaccines your doctor advises, such as the yearly flu vaccine."
  },
  {
   "id": "tb-cough",
   "title": "Cough for more than 2 weeks",
   "target": "follow_up_advice",
   "text": "If you have a cough for more than 2 weeks, fever, night sweats or weight loss, get your sputum tested for TB. Cover your mouth and nose when you cough and keep rooms airy. If TB is found, take every dose for the full course, even when you feel better."
  }
 ],

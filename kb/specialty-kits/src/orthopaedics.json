 "advice": [
  {
   "id": "cast-care",
   "title": "Caring for your plaster",
   "target": "diet_lifestyle_advice",
   "text": "Keep the limb raised, especially for the first few days, and do not let it hang down. Move the fingers or toes and the joints outside the plaster often. Keep the plaster dry and away from fire, and contact the hospital if it cracks, becomes soft, loose or tight, or anything falls inside it."
  },
  {
   "id": "cast-warning-signs",
   "title": "Plaster warning signs",
   "target": "follow_up_advice",
   "text": "Come back at once if the pain keeps getting worse, the fingers or toes become blue, swollen, numb or tingling or you cannot move them, you get pain in the calf, chest pain or breathlessness, or there is rubbing, discharge, wetness or a bad smell under the plaster."
  },
  {
   "id": "back-pain-warning-signs",
   "title": "Back pain or sciatica: when to come at once",
   "target": "follow_up_advice",
   "text": "Come to hospital at once if you get numbness between your legs or around your back passage or genitals, difficulty passing or controlling urine, leaking urine or stools, loss of feeling when you pass urine or stools, new weakness in both legs, or a change in sexual function."
  }
 ],

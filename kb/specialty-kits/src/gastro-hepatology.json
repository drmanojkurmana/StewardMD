  {
   "id": "gi-liver-red-flags",
   "title": "GI and liver red flags",
   "target": "sys_examination",
   "alert": "GI or liver emergency: resuscitate and send to emergency care now. Unstable upper GI bleeding needs endoscopy immediately after resuscitation (NICE CG141); follow the variceal bleeding protocol in known or suspected cirrhosis. Suspected SBP, encephalopathy, acute liver failure, cholangitis, hepatorenal syndrome or acute severe colitis: admit and follow the protocol.",
   "fields": [
    { "id": "rf_unstable_bleed", "label": "Haematemesis or melaena with fast pulse, low BP or fainting", "type": "check" },
    { "id": "rf_variceal", "label": "GI bleed in known cirrhosis or varices", "type": "check" },
    { "id": "rf_encephalopathy", "label": "New confusion or drowsiness in liver disease", "type": "check" },
    { "id": "rf_sbp", "label": "Fever, abdominal pain or tenderness with ascites (possible SBP)", "type": "check" },
    { "id": "rf_alf", "label": "New jaundice with confusion or bleeding tendency (possible acute liver failure)", "type": "check" },
    { "id": "rf_cholangitis", "label": "Fever with jaundice and right upper quadrant pain (possible cholangitis)", "type": "check" },
    { "id": "rf_hrs", "label": "Falling urine output or rising creatinine in cirrhosis", "type": "check" },
    { "id": "rf_severe_colitis", "label": "6 or more bloody stools a day with fever, fast pulse or anaemia (possible acute severe colitis)", "type": "check" },
    { "id": "rf_acute_abdomen", "label": "Severe abdominal pain with guarding, distension or absent bowel sounds", "type": "check" },
    { "id": "rf_food_bolus", "label": "Food stuck, unable to swallow saliva", "type": "check" }
   ]
  }

 "advice": [
  {
   "id": "dyspepsia-lifestyle",
   "title": "Indigestion and acidity",
   "target": "diet_lifestyle_advice",
   "text": "Eat healthy, regular meals, lose weight if you are overweight and stop smoking. Avoid things that bring on your symptoms, such as alcohol, coffee, chocolate and fatty food. Have your main meal at least 3 hours before going to bed, and raise the head end of your bed."
  },
  {
   "id": "liver-care",
   "title": "Looking after your liver",
   "target": "diet_lifestyle_advice",
   "text": "Stop alcohol completely. If you have fluid in the abdomen, do not add salt at the table and avoid pickles, papads and ready-made or packaged foods, but do not stop salt completely. Do not take painkillers such as ibuprofen or diclofenac (NSAIDs), and ask your doctor before starting any new medicine."
  },
  {
   "id": "gi-liver-warning-signs",
   "title": "Bleeding and liver warning signs",
   "target": "follow_up_advice",
   "text": "Come to hospital at once if you vomit blood or dark coffee-ground material, pass black tarry stools or a lot of blood, feel faint, become confused or unusually sleepy, or have fever with abdominal pain or swelling, or yellow eyes that are getting worse."
  }
 ],

 "advice": [
  {
   "id": "mouth-and-tobacco",
   "title": "Tobacco, areca nut and your mouth",
   "target": "diet_lifestyle_advice",
   "text": "Almost all mouth cancers are linked to tobacco, and areca nut (supari, paan masala) also raises the risk. Stop both completely; ask us about the nearest tobacco cessation centre. See a doctor if a mouth ulcer, white or red patch or lump does not heal in 2 weeks, or if it becomes hard to open your mouth."
  },
  {
   "id": "breast-awareness",
   "title": "Know your breasts",
   "target": "follow_up_advice",
   "text": "See a doctor without delay if you notice a lump in the breast or armpit, a change in the shape or size of a breast, dimpling or thickening of the skin, a nipple that pulls in, or blood-stained discharge from the nipple."
  },
  {
   "id": "cervical-screening",
   "title": "Cervical cancer screening",
   "target": "follow_up_advice",
   "text": "Women aged 30 to 65 years should have a cervical screening test once every 5 years. See a doctor early for bleeding after intercourse, bleeding between periods or after menopause, or a foul-smelling discharge."
  },
  {
   "id": "screen-positive",
   "title": "If your screening test is positive",
   "target": "follow_up_advice",
   "text": "A positive screening test does not mean you have cancer. It means you need a further test at the referral hospital to confirm. Go on the date given and take this record with you; early treatment works best."
  }
 ],

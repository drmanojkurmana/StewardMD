 "advice": [
  {
   "id": "medicine-list",
   "title": "Keep a list of your medicines",
   "target": "diet_lifestyle_advice",
   "text": "Keep an up-to-date list of every medicine you take, including those bought without a prescription, herbal and home remedies, and show it to every doctor and pharmacist. Bring all your medicines with you each time you come to hospital."
  },
  {
   "id": "high-alert-medicines",
   "title": "Medicines that need extra care",
   "target": "follow_up_advice",
   "text": "Some medicines, such as blood thinners, insulin and strong pain killers, can cause serious harm if taken wrongly. Take them exactly as instructed, do not change or stop them on your own, and come to hospital at once if you feel unwell after taking them."
  },
  {
   "id": "report-side-effects",
   "title": "Side effects of medicines",
   "target": "follow_up_advice",
   "text": "If you think a medicine has caused a side effect, tell your doctor or pharmacist. Side effects can be reported to the Pharmacovigilance Programme of India to make medicines safer for everyone."
  }
 ],

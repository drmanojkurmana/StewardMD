 "advice": [
  {
   "id": "fever-home-care",
   "title": "Fever: care at home and when to come back",
   "target": "follow_up_advice",
   "text": "Give plenty of fluids and keep feeding or breastfeeding. Give fever medicine only as prescribed for the child's weight. Come back at once if the child cannot drink or breastfeed, vomits everything, has a fit, becomes very sleepy or hard to wake, breathes fast or with difficulty, or has a rash that does not fade when pressed."
  },
  {
   "id": "diarrhoea-home-care",
   "title": "Diarrhoea: ORS, zinc and when to come back",
   "target": "follow_up_advice",
   "text": "Give ORS after every loose stool and keep feeding or breastfeeding. Give the zinc tablets every day for as many days as prescribed, even after the diarrhoea stops. Come back at once if the child drinks poorly, becomes sicker, has blood in the stool, or passes very little urine."
  },
  {
   "id": "infant-feeding",
   "title": "Breastfeeding and complementary feeding",
   "target": "diet_lifestyle_advice",
   "text": "Give only breast milk, no water or other milk, for the first 6 months. From 6 months add soft family foods, 2 to 3 meals a day at 6 to 8 months and 3 to 4 meals a day from 9 months with 1 to 2 snacks, and keep breastfeeding to 2 years or beyond. During illness give more fluids and more frequent breastfeeds."
  },
  {
   "id": "newborn-danger-signs",
   "title": "Newborn danger signs",
   "target": "follow_up_advice",
   "text": "Bring the baby at once if the baby is not feeding well, has a fit, breathes fast or with difficulty, feels hot or cold, moves less than usual, has yellow palms or soles, or has redness or pus around the cord."
  }
 ],

{"stable_angina":{"flowcharts":[{"id":"cad-test-choice","title":"Picking a stress test for known or suspected coronary artery disease","start":"n1","nodes":[{"id":"n1","type":"start","text":"Known or suspected CAD: decide what the test must answer","cite":"c1"},{"id":"n2","type":"decision","text":"Can the patient exercise adequately?","cite":"c1"},{"id":"n3","type":"action","text":"Plan a pharmacologic (drug-stress) imaging study","cite":"c1"},{"id":"n4","type":"decision","text":"Is structural (wall motion, valve, chamber) information needed?","cite":"c1"},{"id":"n5","type":"outcome","text":"Dobutamine stress echocardiography","cite":"c1"},{"id":"n6","type":"decision","text":"LBBB, paced rhythm, or prior myocardial infarction?","cite":"c1"},{"id":"n7","type":"outcome","text":"Pharmacologic nuclear perfusion study; PET is worth considering in morbid obesity or large dense breasts","cite":"c1"},{"id":"n8","type":"outcome","text":"Dobutamine stress echo or a pharmacologic nuclear study, either is acceptable","cite":"c1"},{"id":"n9","type":"decision","text":"Has the patient had coronary revascularization before?","cite":"c1"},{"id":"n10","type":"decision","text":"Can the resting ECG be interpreted for ischaemia?","cite":"c1"},{"id":"n11","type":"outcome","text":"Exercise ECG (treadmill) test","cite":"c1"},{"id":"n12","type":"action","text":"Plan an exercise imaging study","cite":"c1"},{"id":"n13","type":"decision","text":"Is structural information needed?","cite":"c1"},{"id":"n14","type":"outcome","text":"Exercise echocardiography","cite":"c1"},{"id":"n15","type":"decision","text":"LBBB or paced rhythm?","cite":"c1"},{"id":"n16","type":"outcome","text":"Pharmacologic nuclear perfusion study","cite":"c1"},{"id":"n17","type":"decision","text":"Prior myocardial infarction?","cite":"c1"},{"id":"n18","type":"outcome","text":"Exercise nuclear perfusion study","cite":"c1"},{"id":"n19","type":"outcome","text":"Exercise nuclear study or exercise echo, either is acceptable","cite":"c1"},{"id":"n20","type":"outcome","text":"Myocardial viability: PET or thallium-201 imaging","cite":"c1"}],"edges":[{"from":"n1","to":"n2","label":"Ischaemia testing"},{"from":"n1","to":"n20","label":"Viability question"},{"from":"n2","to":"n3","label":"No"},{"from":"n2","to":"n9","label":"Yes"},{"from":"n3","to":"n4","label":"Next"},{"from":"n4","to":"n5","label":"Yes"},{"from":"n4","to":"n6","label":"No"},{"from":"n6","to":"n7","label":"Yes"},{"from":"n6","to":"n8","label":"No"},{"from":"n9","to":"n12","label":"Yes"},{"from":"n9","to":"n10","label":"No"},{"from":"n10","to":"n11","label":"Yes"},{"from":"n10","to":"n12","label":"No"},{"from":"n12","to":"n13","label":"Next"},{"from":"n13","to":"n14","label":"Yes"},{"from":"n13","to":"n15","label":"No"},{"from":"n15","to":"n16","label":"Yes"},{"from":"n15","to":"n17","label":"No"},{"from":"n17","to":"n18","label":"Yes"},{"from":"n17","to":"n19","label":"No"}]}],"valueTables":[],"citations":[{"id":"c1","label":"Harrison's Manual of Medicine, 20th ed., chart: choice of test for known/suspected CAD","kind":"user-supplied"}],"status":"ai_drafted"}}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stewardmd/kb/treatment.schema.json",
  "title": "StewardMD Treatment (recommendation object)",
  "description": "Treatment recommendations, kept SEPARATE from disease knowledge. Carries parallel recommendations from multiple sources; the engine resolves the default by precedence. Hospital policy is an OPTIONAL overlay (see policy-overlay.schema.json) and never replaces national/international guidance by default.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "diseaseId", "recommendations", "precedence", "review", "version"],
  "properties": {
    "id": { "type": "string" },
    "diseaseId": { "type": "string", "description": "Disease.id this treats." },
    "precedence": {
      "type": "array",
      "items": { "type": "string", "enum": ["icmr", "guideline", "harrison"] },
      "description": "Default resolution order. Policy = ICMR (default for India) ▸ international guideline ▸ Harrison (fallback when guidelines silent). Hospital overlay is applied on top only when the user selects their hospital."
    },
    "recommendations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["tier", "line"],
        "properties": {
          "tier": { "type": "string", "enum": ["icmr", "guideline", "harrison", "hospital"], "description": "Source class — drives precedence." },
          "line": { "type": "string", "enum": ["empiric", "definitive", "alternative", "supportive", "adjunct"] },
          "regimenLabel": { "type": "string", "description": "Human-readable regimen, e.g. 'Ceftriaxone + Vancomycin'." },
          "drugRefs": {
            "type": "array",
            "description": "Structured links into the Drug Index by composition (the ONLY pharmacology DB) — never free-text-only, never duplicated drug data.",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["composition"],
              "properties": {
                "composition": { "type": "string", "description": "Normalized generic / composition key (Drug Index)." },
                "dose": { "type": ["string", "null"] }, "route": { "type": ["string", "null"] },
                "freq": { "type": ["string", "null"] }, "duration": { "type": ["string", "null"] },
                "comboLabel": { "type": ["string", "null"], "description": "If part of a combination regimen." }
              }
            }
          },
          "evidence": {
            "type": "object", "additionalProperties": false, "required": ["source"],
            "properties": {
              "source": { "type": "string", "description": "e.g. ICMR, IDSA, ATS/IDSA, KDIGO, ADA, ACC/AHA, ESC, GOLD, GINA, AASLD, EASL, Harrison 22e." },
              "ref": { "type": ["string", "null"] },
              "locator": { "type": "object", "additionalProperties": false, "properties": { "page": { "type": ["integer", "null"] }, "section": { "type": ["string", "null"] } } },
              "grade": { "type": ["string", "null"], "description": "Strength/quality if stated by the guideline." }
            }
          },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "description": "Recorded when sources genuinely disagree — keep BOTH, tagged; engine still shows a primary by precedence.",
      "items": { "type": "object", "additionalProperties": false, "properties": { "topic": { "type": "string" }, "note": { "type": "string" } } }
    },
    "review": { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "type": "string", "enum": ["draft", "ai_drafted", "in_review", "approved", "deprecated"] }, "reviewedBy": { "type": ["string", "null"] }, "reviewedAt": { "type": ["string", "null"] } } },
    "version": { "type": "integer", "minimum": 1 },
    "contentHash": { "type": ["string", "null"] }
  }
}

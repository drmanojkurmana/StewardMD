            }
          ],
          "cite": "c4"
        },
        {
          "parameter": "Intestinal lymphoma",
          "cells": [
            {
              "text": "Patchy, specific"
            },
            {
              "text": "Malignant cells in lamina propria and submucosa"
            }
          ],
          "cite": "c4"
        },
        {
          "parameter": "Intestinal lymphangiectasia",
          "cells": [
            {
              "text": "Patchy, specific"
            },
            {
              "text": "Dilated lymphatics; clubbed villi"
            }
          ],
          "cite": "c4"
        },
        {
          "parameter": "Eosinophilic gastroenteritis",
          "cells": [
            {
              "text": "Patchy, specific"
            },
            {
              "text": "Eosinophil infiltration of lamina propria and mucosa"
            }
          ],
          "cite": "c4"
        },
        {
          "parameter": "Amyloidosis",
          "cells": [
            {
              "text": "Patchy, specific"
            },
            {
              "text": "Amyloid deposits"
            }
          ],
          "cite": "c4"
        },
        {
          "parameter": "Crohn's disease",
          "cells": [
            {
              "text": "Patchy, specific"
            },
            {
              "text": "Noncaseating granulomas"
            }
          ],
          "cite": "c4"
        },
        {
          "parameter": "Infection by one or more microorganisms",
          "cells": [
            {
              "text": "Patchy, specific"
            },
            {
              "text": "Specific organisms seen (see text)"
            }
          ],
          "cite": "c4"
        },
        {
          "parameter": "Mastocytosis",
          "cells": [
            {
              "text": "Patchy, specific"
            },
            {
              "text": "Mast cell infiltration of lamina propria"
            }
          ],
          "cite": "c4"
        },
        {

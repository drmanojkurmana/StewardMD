  "valueTables": [
    {
      "id": "b12_deficiency-diagnostic",
      "kind": "diagnostic",
      "title": "Diagnosing vitamin B12 deficiency",
      "rowHeader": "Criterion",
      "columns": [
        "Threshold",
        "Interpretation"
      ],
      "rows": [
        {
          "parameter": "Serum B12",
          "unit": "pg/mL",
          "cells": [
            {
              "text": "<200 (<145 pmol/L)",
              "op": "<",
              "value": 200
            },
            {
              "text": "{{hy:Deficiency}}"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Serum B12, low-normal",
          "unit": "pg/mL",
          "cells": [
            {
              "text": "200 to 350",
              "range": [
                200,
                350
              ]
            },
            {
              "text": "Check MMA and homocysteine if suspicion persists"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Methylmalonic acid",
          "cells": [
            {
              "text": "Raised"
            },
            {
              "text": "B12 deficiency; normal in folate deficiency; also rises in renal failure"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Homocysteine",
          "cells": [
            {
              "text": "Raised"
            },
            {
              "text": "Either B12 or folate deficiency"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Holotranscobalamin II",
          "unit": "pg/mL",
          "cells": [
            {
              "text": "<40",
              "op": "<",
              "value": 40
            },
            {
              "text": "Indicates deficiency"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Blood count and film",
          "cells": [
            {
              "text": "Macrocytosis, hypersegmented neutrophils"
            },
            {
              "text": "Megaloblastic picture; can precede anaemia"
            }
          ],
          "cite": "c1"
        },
        {
          "parameter": "LDH and bilirubin",
          "cells": [
            {
              "text": "Raised"
            },
            {
              "text": "Ineffective erythropoiesis"
            }
          ],
          "cite": "c1"
        },
        {
          "parameter": "Intrinsic factor antibodies",
          "cells": [
            {
              "text": "Positive"
            },
            {
              "text": "Pernicious anaemia; sensitivity can be poor"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Neurological signs",
          "cells": [
            {
              "text": "Loss of position and vibration sense, weakness, ataxia, extensor plantars"
            },
            {
              "text": "Can occur without anaemia"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Schilling test, urinary excretion",
          "unit": "%",
          "cells": [
            {
              "text": "<5% means poor absorption",
              "op": "<",
              "value": 5
            },
            {
              "text": ">=9% normal; rarely used now"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Schilling pattern: pernicious anaemia",
          "cells": [
            {
              "text": "Low; corrects with intrinsic factor"
            },
            {
              "text": "Not with pancreatic enzymes or antibiotics"
            }
          ],
          "cite": "c3"
        },
        {
          "parameter": "Schilling pattern: chronic pancreatitis",
          "cells": [
            {
              "text": "Low; corrects with pancreatic enzymes"
            },
            {
              "text": "Separates causes of malabsorption"
            }
          ],
          "cite": "c3"
        },
        {
          "parameter": "Schilling pattern: bacterial overgrowth",
          "cells": [
            {
              "text": "Low; corrects after 5 days of antibiotics"
            },
            {
              "text": "Separates causes of malabsorption"
            }
          ],
          "cite": "c3"
        },
        {
          "parameter": "Schilling pattern: ileal disease",
          "cells": [
            {
              "text": "Low; no correction with any step"
            },
            {
              "text": "Separates causes of malabsorption"
            }
          ],
          "cite": "c3"
        }
      ]
    },
    {
      "id": "b12_deficiency-ddx",
      "kind": "ddx",
      "title": "Conditions that mimic B12 deficiency",
      "rowHeader": "Condition",
      "columns": [
        "Key distinguishing feature"
      ],
      "rows": [
        {
          "parameter": "Folate deficiency",
          "cells": [
            {
              "text": "{{hy:Normal MMA}}; folate alone may mask B12 deficiency"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Antifolate drugs such as methotrexate",
          "cells": [
            {
              "text": "Drug history"
            }
          ],
          "cite": "c3"
        },
        {
          "parameter": "Drugs affecting DNA synthesis (for example zidovudine)",
          "cells": [
            {
              "text": "Drug history"
            }
          ],
          "cite": "c3"
        },
        {
          "parameter": "Myelodysplasia or AML",
          "cells": [
            {
              "text": "Refractory megaloblastic change with normal vitamins"
            }
          ],
          "cite": "c3"
        },
        {
          "parameter": "Dementia",
          "cells": [
            {
              "text": "Cognitive change in older adults without B12 markers"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Nitrous oxide exposure",
          "cells": [
            {
              "text": "Repeated use impairs B12 utilisation"
            }
          ],
          "cite": "c2"
        }
      ]
    },
    {
      "id": "b12_deficiency-treatment",
      "kind": "treatment",
      "title": "Treatment of vitamin B12 deficiency",
      "rowHeader": "Option",
      "columns": [
        "When to use",
        "Dose or notes"
      ],
      "rows": [
        {
          "parameter": "Parenteral vitamin B12",
          "cells": [
            {
              "text": "{{hy:Severe deficiency or neurological involvement}}"
            },
            {
              "text": "1 mg IM 1 to 4 times weekly until counts correct, then 1 mg IM monthly"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Oral vitamin B12",
          "cells": [
            {
              "text": "No severe deficiency or neurological signs"
            },
            {
              "text": "1000 to 2000 mcg once daily; absorbed even without intrinsic factor"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Do not give folate alone",
          "cells": [
            {
              "text": "Any suspected B12 deficiency"
            },
            {
              "text": "Anaemia improves while nerve damage progresses"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Treat the cause",
          "cells": [
            {
              "text": "Pernicious anaemia, gastric surgery, ileal disease, metformin, diet"
            },
            {
              "text": "Lifelong therapy unless cause corrected"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Monitor response",
          "cells": [
            {
              "text": "After starting treatment"
            },
            {
              "text": "Reticulocytes rise within about 1 week; counts correct by 6 weeks"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Screen for autoimmune disease",
          "cells": [
            {
              "text": "Pernicious anaemia"
            },
            {
              "text": "Associated autoimmune conditions"
            }
          ],
          "cite": "c1"
        }
      ],
      "footnote": "Neurological recovery is slow and deficits of months to years may be permanent, so do not wait for a haematological response before treating."
    },
    {
      "id": "b12_deficiency-diagnostic-2",
      "kind": "diagnostic",
      "title": "Diseases diagnosable by small-intestinal mucosal biopsy",

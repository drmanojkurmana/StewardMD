            },
            {
              "text": "Similar to celiac disease"
            }
          ],
          "cite": "c4"
        },
        {
          "parameter": "Bacterial overgrowth",
          "cells": [
            {
              "text": "Diffuse, nonspecific"
            },
            {
              "text": "Patchy villous damage; lymphocyte infiltration"
            }
          ],
          "cite": "c4"
        },
        {
          "parameter": "Folate deficiency",
          "cells": [

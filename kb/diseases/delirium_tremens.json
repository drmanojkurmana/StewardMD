    "reasoningTemplate": "Agitation, autonomic hyperactivity, tremor and altered sensorium 48-96 h after the last drink in a heavy drinker suggest delirium tremens — but CNS infection and Wernicke's must be excluded in parallel in any febrile or altered patient."
  },
  "redFlags": [
    "Do NOT anchor on withdrawal in a febrile/altered patient — exclude meningitis/encephalitis (LP) and give thiamine before glucose (Wernicke)",
    "Autonomic storm — hyperthermia, arrhythmia; DT carries appreciable mortality if untreated",
    "Withdrawal seizures may herald DT"
  ],
  "investigations": [
    {
      "test": "Bedside glucose + IV thiamine before glucose (Wernicke prophylaxis)"
    },
    {
      "test": "Exclude CNS infection / structural cause (LP, imaging) when febrile, focal or atypical"
    },
    {
      "test": "Electrolytes incl. Mg/PO4, LFTs; assess CIWA-Ar"
    }
  ],

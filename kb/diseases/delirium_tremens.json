    {
      "id": "delirium_tremens-treatment",
      "kind": "treatment",
      "title": "Treatment of alcohol withdrawal and delirium tremens",
      "rowHeader": "Option",
      "columns": [
        "When to use",
        "Dose or notes"
      ],
      "rows": [
        {
          "parameter": "Thiamine IV",
          "cells": [
            {
              "text": "{{hy:All patients, before glucose}}"
            },
            {
              "text": "100 mg IV"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Diazepam",
          "cells": [
            {
              "text": "Symptomatic withdrawal"
            },
            {
              "text": "5 to 10 mg IV or PO hourly until sedated"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Diazepam or lorazepam IV for DT",
          "cells": [
            {
              "text": "Delirium tremens"
            },
            {
              "text": "Diazepam 5 to 10 mg or lorazepam 1 to 2 mg every 10 min; no maximum dose"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Lorazepam or oxazepam",
          "cells": [
            {
              "text": "Liver disease"
            },
            {
              "text": "Preferred benzodiazepines"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Chlordiazepoxide",
          "cells": [
            {
              "text": "Less severe withdrawal"
            },
            {
              "text": "50 to 100 mg PO every 4 to 6 h, then taper"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Lorazepam for seizures",
          "cells": [
            {
              "text": "Repeated or prolonged seizures"
            },
            {
              "text": "1 to 3 mg IV; phenytoin not helpful"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Phenobarbital",
          "cells": [
            {
              "text": "Alternative first agent or benzodiazepine-refractory DT"
            },
            {
              "text": "10 mg/kg IV, or 120 to 240 mg IV every 20 min; watch breathing"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Infusion with ventilation",
          "cells": [
            {
              "text": "Severe drug-resistant DT"
            },
            {
              "text": "Lorazepam, midazolam, propofol or dexmedetomidine"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "IV fluids, magnesium, multivitamins",
          "cells": [
            {
              "text": "Volume depletion and deficits"
            },
            {
              "text": "Supportive"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "Avoid haloperidol or phenothiazines initially",
          "cells": [
            {
              "text": "Agitation"
            },
            {
              "text": "May lower seizure threshold"
            }
          ],
          "cite": "c2"
        },
        {
          "parameter": "ICU care",
          "cells": [
            {
              "text": "Severe withdrawal or DT"
            },
            {
              "text": "Until symptoms settle"
            }
          ],
          "cite": "c2"
        }
      ],
      "footnote": "The 'thiamine before glucose' order comes from the entry text; Merck gives the thiamine dose but not the order."
    }

  "investigations": [
    {
      "test": "Chest X-ray",
      "why": "Aspiration classically affects dependent lung segments (posterior upper lobes if aspirated supine, basal segments of lower lobes if upright) — helpful in confirming the diagnosis."
    },
    {
      "test": "Swallowing assessment (if recurrent or ongoing risk)",

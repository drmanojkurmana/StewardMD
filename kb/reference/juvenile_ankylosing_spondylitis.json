{
  "id": "juvenile_ankylosing_spondylitis",
  "name": "Juvenile ankylosing spondylitis",
  "aliases": [
    "juvenile-onset ankylosing spondylitis",
    "JAS",
    "juvenile axial spondyloarthritis",
    "juvenile spondyloarthropathy"
  ],
  "class": "non_infective",
  "system": "Rheumatology / Paediatrics",
  "specialty": "Paediatric Rheumatology",
  "referenceOnly": true,
  "reference": {
    "source": "Textbook of Pediatric Rheumatology / ILAR & PRINTO criteria",
    "sourceEdition": "current",
    "pages": null,
    "clinicalPearls": [
      "A juvenile-onset axial spondyloarthritis sharing strong HLA-B27 association and clinical features with enthesitis-related arthritis",
      "In children, peripheral arthritis and enthesitis of the lower limbs and hips often precede axial symptoms by years",
      "Inflammatory back pain (worse at rest and in the early morning, improving with activity) and buttock pain from sacroiliitis mark axial disease",
      "Hip involvement is common in juvenile-onset disease and is an important cause of long-term disability",
      "Acute symptomatic anterior uveitis (painful red eye) can occur, in contrast to the chronic silent uveitis of oligoarticular JIA",
      "MRI detects active sacroiliitis before plain radiographs show structural change, aiding early diagnosis",
      "Management uses NSAIDs and physiotherapy first line, with TNF inhibition for persistent axial disease or inadequate response"
    ],
    "pathophysiology": "Juvenile ankylosing spondylitis is an axial spondyloarthritis in which HLA-B27-associated immune dysregulation, with prominent involvement of the interleukin-23/interleukin-17 pathway, drives inflammation at entheses, sacroiliac joints and the spine. Enthesitis and osteitis are followed by reparative new bone formation, which over time can produce syndesmophytes, joint fusion and progressive loss of spinal and sacroiliac mobility. Because the skeleton is still growing, hip and axial involvement in childhood can have particularly significant functional and structural consequences.",
    "additionalDifferentials": [
      "Enthesitis-related arthritis and other juvenile spondyloarthritis",
      "Mechanical back pain and postural causes",
      "Chronic non-bacterial osteomyelitis affecting the spine",
      "Infective sacroiliitis or discitis",
      "Inflammatory bowel disease-associated arthritis",
      "Other JIA subtypes",
      "Malignancy involving the spine or pelvis"
    ],
    "additionalInvestigations": [
      "HLA-B27 typing to support the diagnosis",
      "MRI of the sacroiliac joints and spine to detect early inflammatory change",
      "Inflammatory markers (erythrocyte sedimentation rate and C-reactive protein)",
      "Radiographs of the sacroiliac joints and spine in established disease",
      "Assessment of spinal mobility and posture for monitoring",
      "Ophthalmology review for symptomatic anterior uveitis",
      "Screening for inflammatory bowel disease when gastrointestinal symptoms occur"
    ],
    "redFlags": [
      "Progressive loss of spinal mobility or fixed deformity",
      "Significant hip involvement threatening mobility",
      "Acute painful red eye requiring urgent ophthalmology assessment",
      "Neurological symptoms or severe night pain suggesting an alternative serious cause",
      "Systemic features suggesting infection or inflammatory bowel disease"
    ],
    "prognosis": "Juvenile-onset disease tends to have more peripheral and hip involvement than adult-onset ankylosing spondylitis and can progress to significant axial disease and disability over years. Early diagnosis, physiotherapy and TNF inhibition improve symptom control and may limit structural progression.",
    "pitfalls": [
      "Attributing inflammatory back and buttock pain to mechanical causes and delaying imaging",
      "Relying on plain radiographs, which are insensitive to early sacroiliitis",
      "Underestimating hip disease as a driver of disability",
      "Assuming HLA-B27 negativity excludes the diagnosis",
      "Missing associated uveitis or inflammatory bowel disease"
    ],
    "references": [
      "Textbook of Pediatric Rheumatology",
      "Consensus guidance on juvenile spondyloarthritis",
      "ASAS criteria for axial spondyloarthritis (adapted to juvenile disease)"
    ],
    "crossLinks": [],
    "management": [
      "Use non-steroidal anti-inflammatory drugs as first-line therapy for inflammatory back pain and enthesitis",
      "Escalate to TNF inhibitors for active axial disease inadequately controlled by NSAIDs, with IL-17 inhibitors as an alternative biologic",
      "Add sulfasalazine for predominant peripheral arthritis",
      "Provide structured physiotherapy and regular exercise to preserve spinal mobility, posture and hip function",
      "Use intra-articular corticosteroid injection for troublesome peripheral joint or entheseal inflammation",
      "Screen for and treat symptomatic acute anterior uveitis with topical corticosteroids and mydriatics alongside ophthalmology",
      "Monitor hip involvement and refer for arthroplasty where destruction causes disability",
      "Follow axial disease with clinical mobility assessment and MRI to detect active sacroiliitis"
    ]
  },

              "text": "Linear band of IgG and/or C3 in the epidermal basement membrane zone"
            },
            {
              "text": "BPAG1, BPAG2"
            }
          ],
          "cite": "c3"
        },
        {
          "parameter": "Pemphigoid gestationis",
          "cells": [
            {
              "text": "Pruritic urticarial plaques rimmed by vesicles and bullae on trunk and extremities"
            },
            {
              "text": "Teardrop-shaped subepidermal blisters in dermal papillae; eosinophil-rich infiltrate"
            },
            {
              "text": "Linear band of C3 in the epidermal basement membrane zone"
            },
            {
              "text": "BPAG2 (plus BPAG1 in some patients)"
            }
          ],
          "cite": "c3"
        },
        {
          "parameter": "Linear IgA disease",
          "cells": [
            {
              "text": "Pruritic small papules on extensor surfaces; occasionally larger arciform blisters"
            },
            {
              "text": "Subepidermal blister with neutrophil-rich infiltrate"
            },
            {
              "text": "Linear band of IgA in the epidermal basement membrane zone"
            },
            {
              "text": "BPAG2"
            }
          ],
          "cite": "c3"
        },
        {
          "parameter": "Cicatricial pemphigoid",
          "cells": [
            {
              "text": "Erosive and/or blistering lesions of mucous membranes and possibly skin; scarring at some sites"
            },
            {
              "text": "Subepidermal blister, leukocytic infiltrate may or may not be present"
            },
            {
              "text": "Linear band of IgG, IgA and/or C3 in the epidermal basement membrane zone"
            },
            {
              "text": "BPAG2, laminin-332, or others"
            }
          ],
          "cite": "c3"
        },
        {
          "parameter": "Epidermolysis bullosa acquisita",
          "cells": [
            {
              "text": "Blisters, erosions, scars and milia at trauma-exposed sites; widespread inflammatory tense blisters may be seen initially"
            },
            {
              "text": "Subepidermal blister, leukocytic infiltrate may or may not be present"
            },
            {
              "text": "Linear band of IgG and/or C3 in the epidermal basement membrane zone"
            },
            {
              "text": "Type VII collagen"
            }
          ],
          "cite": "c3"
        },
        {
          "parameter": "Dermatitis herpetiformis",
          "cells": [
            {
              "text": "Extremely pruritic small papules and vesicles on elbows, knees, buttocks and posterior neck"
            },
            {
              "text": "Subepidermal blister with neutrophils in dermal papillae"
            },
            {
              "text": "Granular IgA deposits in dermal papillae"
            },
            {
              "text": "Epidermal transglutaminase"
            }
          ],
          "cite": "c3"
        }
      ],
      "footnote": "Dsg1, desmoglein 1; Dsg3, desmoglein 3; BPAG1, bullous pemphigoid antigen 1; BPAG2, bullous pemphigoid antigen 2."
    }

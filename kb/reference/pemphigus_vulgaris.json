  "flowcharts": [
    {
      "id": "pemphigus_vulgaris-dx-mgmt",
      "title": "Diagnosis and management of Pemphigus vulgaris",
      "start": "n1",
      "nodes": [
        {
          "id": "n1",
          "type": "start",
          "text": "Painful skin and mucosal erosions with suspected pemphigus vulgaris",
          "cite": "c1"
        },
        {
          "id": "n2",
          "type": "decision",
          "text": "Red flag (extensive erosions, cannot eat or drink, sepsis, paraneoplastic features)?",
          "cite": "c1"
        },
        {
          "id": "n3",
          "type": "outcome",
          "text": "Escalate to inpatient specialist care for fluid loss and sepsis risk",
          "cite": "c1"
        },
        {
          "id": "n4",
          "type": "action",
          "text": "Skin or mucosal biopsy for acantholysis; perilesional direct immunofluorescence",
          "cite": "c1"
        },
        {
          "id": "n5",
          "type": "decision",
          "text": "Do biopsy and immunofluorescence show acantholysis with intercellular IgG and C3?",
          "cite": "c1"
        },
        {
          "id": "n6",
          "type": "action",
          "text": "Consider bullous pemphigoid, mucous membrane pemphigoid or erosive lichen planus",
          "cite": "c1"
        },
        {
          "id": "n7",
          "type": "action",
          "text": "Induce remission with systemic corticosteroids combined with rituximab",
          "cite": "c1"
        },
        {
          "id": "n8",
          "type": "action",
          "text": "Add azathioprine or mycophenolate mofetil to spare corticosteroids",
          "cite": "c1"
        },
        {
          "id": "n9",
          "type": "action",
          "text": "Use immunoglobulin or immunoadsorption for severe or refractory disease",
          "cite": "c1"
        },
        {
          "id": "n10",
          "type": "action",
          "text": "Give wound care with fluid and protein replacement; treat secondary infection",
          "cite": "c1"
        },
        {
          "id": "n11",
          "type": "action",
          "text": "Provide analgesia and oral care; monitor anti-desmoglein titres",
          "cite": "c1"
        },
        {
          "id": "n12",
          "type": "outcome",
          "text": "Much better outlook with modern therapy but remains a serious chronic disease",
          "cite": "c1"
        }
      ],

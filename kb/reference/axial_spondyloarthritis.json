{
  "id": "axial_spondyloarthritis",
  "name": "Axial spondyloarthritis",
  "aliases": [
    "axSpA",
    "radiographic and non-radiographic axial spondyloarthritis"
  ],
  "class": "non_infective",
  "system": "Musculoskeletal",
  "specialty": "Rheumatology",
  "referenceOnly": true,
  "reference": {
    "source": "Rheumatology references / ASAS classification",
    "sourceEdition": "current",
    "pages": null,
    "clinicalPearls": [
      "A chronic inflammatory disease of the axial skeleton, encompassing ankylosing spondylitis (radiographic) and non-radiographic forms",
      "The hallmark is inflammatory back pain: insidious onset before middle age, morning stiffness, improvement with exercise and not with rest, and night pain",
      "It is strongly associated with HLA-B27 and with sacroiliitis on imaging",
      "Extra-articular features include acute anterior uveitis, psoriasis and inflammatory bowel disease",
      "MRI detects active sacroiliitis before radiographic changes appear, enabling earlier diagnosis",
      "Management combines exercise and NSAIDs with biologic therapy (TNF or IL-17 inhibitors) for active disease"
    ],
    "pathophysiology": "Axial spondyloarthritis is an immune-mediated inflammatory disorder centred on the entheses and sacroiliac joints, in which inflammation at sites of ligament and tendon insertion is followed by reactive new bone formation. Genetic susceptibility, especially HLA-B27, and dysregulated innate and adaptive immunity involving the interleukin-23/17 axis drive the process. Over time, inflammation of the spine and sacroiliac joints can lead to syndesmophyte formation, ankylosis and loss of spinal mobility, while shared immunopathology explains the associated uveitis, psoriasis and bowel inflammation.",
    "additionalDifferentials": [
      "Mechanical (non-inflammatory) back pain",
      "Diffuse idiopathic skeletal hyperostosis",
      "Psoriatic or enteropathic spondyloarthritis",
      "Osteitis condensans ilii",
      "Infective sacroiliitis"
    ],
    "additionalInvestigations": [
      "Assessment of inflammatory back pain features",
      "HLA-B27 testing",
      "MRI of the sacroiliac joints for active inflammation",
      "Radiographs of the sacroiliac joints and spine",
      "Inflammatory markers and screening for extra-articular disease"
    ],
    "redFlags": [
      "Features suggesting infective sacroiliitis or malignancy",
      "Acute anterior uveitis",
      "Rapid loss of spinal mobility or spinal fracture in ankylosed spine",
      "Cauda equina syndrome (rare, in long-standing disease)"
    ],
    "prognosis": "Course is variable; early diagnosis and modern therapy can control symptoms and improve function, though some progress to spinal ankylosis with disability.",
    "pitfalls": [
      "Dismissing chronic back pain in a young adult as mechanical",
      "Relying on radiographs alone and missing early disease detectable on MRI",
      "Overlooking extra-articular clues such as uveitis",
      "Forgetting the high fracture risk of an ankylosed spine after trauma"
    ],
    "references": [
      "ASAS classification criteria",
      "Rheumatology reference texts (standard reference)"
    ],
    "crossLinks": [],
    "management": [
      "Structured exercise and physiotherapy to preserve spinal mobility, posture and function form the cornerstone of management",
      "Use NSAIDs as first-line pharmacotherapy for inflammatory pain and stiffness",
      "For active disease refractory to NSAIDs, escalate to biologic therapy with a TNF inhibitor or IL-17 inhibitor, or a JAK inhibitor as an alternative",
      "Reserve conventional DMARDs such as sulfasalazine for peripheral arthritis, as they do not control axial disease",
      "Identify and co-manage extra-articular disease including acute anterior uveitis, psoriasis and inflammatory bowel disease with the relevant specialists",
      "Monitor disease activity and function with validated indices, and screen for and treat osteoporosis and cardiovascular risk while remaining alert to fracture through the rigid ankylosed spine",
      "Coordinate long-term care through rheumatology and refer for physiotherapy and, where deformity is severe, spinal surgery"
    ]
  },

 "flowcharts": [
  {
   "id": "adult-jaundice-approach",
   "title": "Working up jaundice in an adult",
   "start": "j1",
   "nodes": [
    {
     "id": "j1",
     "type": "start",
     "text": "Take a history (including every medicine and drug exposure), examine, and send bilirubin with direct/indirect split, ALT, AST, alkaline phosphatase, PT and albumin",
     "cite": "c5"
    },
    {
     "id": "j2",
     "type": "decision",
     "text": "Is bilirubin the only abnormal liver test?",
     "cite": "c5"
    },
    {
     "id": "j3",
     "type": "decision",
     "text": "What share of total bilirubin is direct (conjugated)?",
     "cite": "c5"
    },
    {
     "id": "j4",
     "type": "outcome",
     "text": "Consider inherited conjugated hyperbilirubinaemia: Dubin-Johnson or Rotor syndrome",
     "cite": "c5"
    },
    {
     "id": "j5",
     "type": "outcome",
     "text": "Consider drugs (rifampicin, probenecid), inherited causes (Gilbert, Crigler-Najjar), haemolysis, or ineffective erythropoiesis",
     "cite": "c5"
    },
    {
     "id": "j6",
     "type": "decision",
     "text": "Which pattern dominates the other liver tests?",
     "cite": "c5"
    },
    {
     "id": "j7",
     "type": "action",
     "text": "Hepatocellular work-up: hepatitis A IgM, HBsAg and hepatitis B core IgM, HCV RNA; toxicology screen with paracetamol (acetaminophen) level; ceruloplasmin if under 40 years; ANA, smooth-muscle antibody, serum protein electrophoresis",
     "cite": "c5"
    },
    {
     "id": "j8",
     "type": "decision",
     "text": "Did the first-line hepatocellular tests find a cause?",
     "cite": "c5"
    },
    {
     "id": "j9",
     "type": "action",
     "text": "Second-line tests: CMV DNA, EBV capsid antigen, hepatitis D antibody if indicated, hepatitis E IgM if indicated",
     "cite": "c5"
    },
    {
     "id": "j10",
     "type": "decision",
     "text": "Did the second-line tests find a cause?",
     "cite": "c5"
    },
    {
     "id": "j11",
     "type": "outcome",
     "text": "Liver biopsy",
     "cite": "c5"
    },
    {
     "id": "j12",
     "type": "outcome",
     "text": "Cause identified by testing; cause-specific management is outside this chart (needs-source)",
     "cite": "c5"
    },
    {
     "id": "j13",
     "type": "action",
     "text": "Cholestatic work-up: abdominal ultrasound",
     "cite": "c5"
    },
    {
     "id": "j14",
     "type": "decision",
     "text": "Are the bile ducts dilated?",
     "cite": "c5"
    },
    {
     "id": "j15",
     "type": "outcome",
     "text": "CT, MRCP or ERCP",
     "cite": "c5"
    },
    {
     "id": "j16",
     "type": "action",
     "text": "Serology: antimitochondrial antibody (AMA), hepatitis serologies including hepatitis A, CMV, EBV; review the drug list",
     "cite": "c5"
    },
    {
     "id": "j17",
     "type": "decision",
     "text": "Serology result?",
     "cite": "c5"
    },
    {
     "id": "j18",
     "type": "outcome",
     "text": "MRCP or liver biopsy",
     "cite": "c5"
    }
   ],

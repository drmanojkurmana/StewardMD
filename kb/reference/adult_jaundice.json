  "valueTables": [
    {
      "id": "adult_jaundice-diagnostic",
      "kind": "diagnostic",
      "title": "Key values in jaundice",
      "rowHeader": "Criterion",
      "columns": [
        "Value",
        "Meaning"
      ],
      "rows": [
        {
          "parameter": "Bilirubin at which jaundice is visible",
          "cells": [
            {
              "text": "about 2 to 3 mg/dL (34 to 51 micromol/L)",
              "range": [
                2,
                3
              ]
            },
            {
              "text": "Mild jaundice is best seen in the sclerae in daylight, usually from 2 to 2.5 mg/dL"
            }
          ],
          "cite": "c6"
        },
        {
          "parameter": "Hepatocellular pattern",
          "cells": [
            {
              "text": "Aminotransferases >500 U/L with ALP <3 times normal",
              "op": ">",
              "value": 500
            },
            {
              "text": "Points to hepatocellular dysfunction"
            }
          ],
          "cite": "c6"
        },
        {
          "parameter": "Cholestatic pattern",
          "cells": [
            {
              "text": "Aminotransferases <200 U/L with ALP and GGT >3 times normal",
              "op": "<",
              "value": 200
            },
            {
              "text": "{{hy:Points to cholestasis; image the bile ducts}}"
            }
          ],
          "cite": "c6"
        },
        {
          "parameter": "Haemolysis",
          "cells": [
            {
              "text": "Bilirubin usually <3.5 mg/dL (<59 micromol/L)",
              "op": "<",
              "value": 3.5
            },
            {
              "text": "No bilirubinuria and normal aminotransferases; confirm on peripheral smear"
            }
          ],
          "cite": "c6"
        },
        {
          "parameter": "Direct fraction when bilirubin is the only abnormal test",
          "cells": [
            {
              "text": "Direct >15% of total",
              "op": ">",
              "value": 15
            },
            {
              "text": "Suggests Dubin-Johnson or Rotor syndrome; under 15% suggests Gilbert, haemolysis or drugs"
            }
          ],
          "cite": "c5"
        },
        {
          "parameter": "Urine bilirubin",
          "cells": [
            {
              "text": "Present only with conjugated hyperbilirubinaemia"
            },
            {
              "text": "Unconjugated bilirubin does not appear in urine"
            }
          ],
          "cite": "c6"
        }
      ],
      "footnote": "The 15% direct-fraction cut-off comes from the Harrison's chart; Merck uses fractionation without a stated cut-off."
    },
    {
      "id": "adult_jaundice-ddx",
      "kind": "ddx",
      "title": "Causes of jaundice and how they differ",
      "rowHeader": "Condition",
      "columns": [
        "Key distinguishing feature",
        "Best test to separate"
      ],
      "rows": [
        {
          "parameter": "Haemolysis",
          "cells": [
            {
              "text": "Few liver signs, sometimes anaemia; unconjugated rise"
            },
            {
              "text": "Peripheral smear"
            }
          ],
          "cite": "c6"
        },
        {
          "parameter": "Gilbert syndrome",
          "cells": [
            {
              "text": "Recurrent mild jaundice with no liver dysfunction, often familial"
            },
            {
              "text": "Bilirubin fractionation with normal liver enzymes"
            }
          ],
          "cite": "c6"
        },
        {
          "parameter": "Viral hepatitis",
          "cells": [
            {
              "text": "Acute jaundice in a young healthy person, often after fever, malaise and myalgia, or with risk factors"
            },
            {
              "text": "Hepatitis A IgM, HBsAg and hepatitis B core IgM, HCV RNA"
            }
          ],
          "cite": "c5"
        },
        {
          "parameter": "Drug-induced liver injury",
          "cells": [
            {
              "text": "Acute jaundice after a new exposure: paracetamol, amiodarone, isoniazid, NSAIDs, statins (hepatocellular); amoxicillin-clavulanate, anabolic steroids, oral contraceptives (cholestatic)"
            },
            {
              "text": "Drug history; paracetamol level"
            }
          ],
          "cite": "c6"
        },
        {
          "parameter": "Alcohol-related liver disease",
          "cells": [
            {
              "text": "Long heavy drinking; Dupuytren contracture, palmar erythema, spider angiomas, gynaecomastia, testicular atrophy"
            },
            {
              "text": "needs-source"
            }
          ],
          "cite": "c6"
        },
        {
          "parameter": "Common bile duct stone",
          "cells": [
            {
              "text": "Colicky right upper quadrant pain; constant pain with fever and rigors suggests cholangitis"
            },
            {
              "text": "{{hy:Abdominal ultrasound first}}, then MRCP, EUS or ERCP"
            }
          ],
          "cite": "c6"
        },
        {
          "parameter": "Pancreatic or biliary cancer",
          "cells": [
            {
              "text": "Older patient, painless jaundice, weight loss, abdominal mass, little itch"
            },
            {
              "text": "CT (better for pancreatic lesions)"
            }
          ],
          "cite": "c6"
        },
        {
          "parameter": "Primary biliary cholangitis",
          "cells": [
            {
              "text": "Itch, xanthomas, hyperpigmentation"
            },
            {
              "text": "Antimitochondrial antibody"
            }
          ],
          "cite": "c6"
        },
        {
          "parameter": "Primary sclerosing cholangitis",
          "cells": [
            {
              "text": "Associated with inflammatory bowel disease"
            },
            {
              "text": "needs-source"
            }
          ],
          "cite": "c6"
        },
        {
          "parameter": "Dubin-Johnson or Rotor syndrome",
          "cells": [
            {
              "text": "Conjugated rise with normal liver enzymes"
            },
            {
              "text": "Bilirubin fractionation"
            }
          ],
          "cite": "c6"
        }
      ],
      "footnote": "Features are from Merck; the viral serology panel and the AMA test are from the Harrison's jaundice chart (c5)."
    },
    {
      "id": "adult_jaundice-treatment",
      "kind": "treatment",
      "title": "Managing jaundice in adults",
      "rowHeader": "Option",
      "columns": [
        "When to use",
        "Notes"
      ],
      "rows": [
        {
          "parameter": "Treat the underlying cause and its complications",
          "cells": [
            {
              "text": "Every patient"
            },
            {
              "text": "{{hy:Jaundice itself needs no treatment in adults}}"
            }
          ],
          "cite": "c6"
        },
        {
          "parameter": "Cholestyramine 2 to 8 g orally twice daily",
          "cells": [
            {
              "text": "Itch from cholestasis"
            },
            {
              "text": "Does not work in complete biliary obstruction"
            }
          ],
          "cite": "c6"
        },
        {
          "parameter": "ERCP",
          "cells": [
            {
              "text": "Extrahepatic obstruction from stones or strictures"
            },
            {
              "text": "Removes stones and places stents; more invasive than MRCP or EUS"
            }
          ],
          "cite": "c6"
        },
        {
          "parameter": "Liver biopsy",
          "cells": [
            {
              "text": "Cause still unclear after serology and imaging"
            },
            {
              "text": "Helps in intrahepatic cholestasis, some hepatitides, infiltrative disease, haemochromatosis, Wilson disease"
            }
          ],
          "cite": "c6"
        }
      ]
    }
  ]
}

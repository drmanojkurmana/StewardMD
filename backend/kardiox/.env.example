# KardioX pipeline configuration (copy to .env). All vars are KARDIOX_-prefixed.

# App
KARDIOX_ENVIRONMENT=dev              # dev | staging | prod
KARDIOX_MODE=mock                    # mock = return the AF sample (app connects end-to-end); live = run the pipeline
KARDIOX_LOG_LEVEL=INFO
KARDIOX_REQUEST_TIMEOUT_S=90
KARDIOX_CORS_ORIGINS=*               # tighten in prod, e.g. https://stewardmd.in

# Auth — shared secret the Cloudflare edge Worker sends as X-Pipeline-Token (leave blank to disable in dev)
KARDIOX_PIPELINE_TOKEN=

# R2 (S3-compatible) — the pipeline reads the ephemeral upload the edge stored
KARDIOX_R2_ENDPOINT=                 # https://<account>.r2.cloudflarestorage.com
KARDIOX_R2_ACCESS_KEY_ID=
KARDIOX_R2_SECRET_ACCESS_KEY=
KARDIOX_R2_BUCKET=kardiox-ephemeral
KARDIOX_R2_UPLOAD_PREFIX=uploads/
KARDIOX_R2_DELETE_AFTER_READ=true

# Providers per stage (none = NotImplemented). Flip to the real impl as models land.
KARDIOX_PROVIDER_PREPROCESSING=none  # → opencv
KARDIOX_PROVIDER_DIGITIZATION=none   # → classical (opencv alias)
KARDIOX_PROVIDER_WFDB=none           # → wfdb
KARDIOX_PROVIDER_RHYTHM=none         # → deterministic (model-free rate/regularity) | torchecg (learned)
KARDIOX_PROVIDER_MEASUREMENT=none    # → neurokit2
KARDIOX_PROVIDER_RULES=builtin       # real deterministic engine (safe to leave on)
KARDIOX_PROVIDER_GEMINI=none         # → gemini

# Gemini (stage 12) — server-side only, never shipped to the client
KARDIOX_GEMINI_API_KEY=
KARDIOX_GEMINI_MODEL=gemini-1.5-pro

# Rhythm model (TorchECG) — KardioX ships NO weights. Set a path to a validated TorchScript checkpoint
# to enable KARDIOX_PROVIDER_RHYTHM=torchecg; empty = provider raises pipeline_unavailable (never faked).
KARDIOX_RHYTHM_MODEL_PATH=
KARDIOX_RHYTHM_MODEL_FS=500
KARDIOX_RHYTHM_MODEL_LABELS=          # comma-separated class labels bundled with the checkpoint

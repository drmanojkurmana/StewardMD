# FundX AI backend — local dev secrets template.
# Copy to `.dev.vars` (gitignored) for `npx wrangler pages dev`. In production these are
# set as Cloudflare Pages env vars / secrets (Dashboard → Settings → Environment variables,
# or `wrangler pages secret put <NAME>`), NEVER committed. The Vertex vars below are the
# SAME ones MaiK already uses — in production they are already configured; you only need
# them locally if you want to exercise real Vertex calls from `pages dev`.

# ---- provider selection + routing (non-secret) ----
FUNDX_AI_PROVIDER=vertex           # vertex (default) | developer | cerebras
# FUNDX_VISION_PROVIDER=vertex     # optional per-task override (vision needs a multimodal provider)
# FUNDX_CLINICAL_PROVIDER=vertex   # vertex | cerebras | developer
# FUNDX_PRIMARY=vertex             # provider router: forced primary (overrides order)
# FUNDX_SECONDARY=developer        # provider router: secondary before base-order fallback
FUNDX_MODEL=gemini-2.5-flash       # do NOT use gemini-2.0-flash
FUNDX_SAFETY=BLOCK_ONLY_HIGH       # Gemini safety threshold (medical content must not over-block)
# FUNDX_PRICES={"vertex":{"in":0.30,"out":2.50},"cerebras":{"in":0.60,"out":0.60}}  # USD/1M tokens, cost estimates

# ---- limits / robustness (non-secret) ----
FUNDX_DAILY_LIMIT=200
FUNDX_RATE_LIMIT_SECONDS=2
FUNDX_TIMEOUT_MS=20000

# ---- app auth token (secret, optional) ----
# If set, the app may send it as X-App-Token. Origin allow-list already covers the
# web + native app, so this is optional. Reuses AI_APP_TOKEN / GHIS_APP_TOKEN if present.
# FUNDX_APP_TOKEN=

# ---- Vertex AI (Gemini) — keyless Workload Identity Federation (SAME as MaiK) ----
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1
GCP_SA_EMAIL=maik-vertex@your-gcp-project-id.iam.gserviceaccount.com
# PKCS8 PEM private key that signs the OIDC JWT (public JWK uploaded to the WIF provider).
# Paste as a single line with \n escapes, or use `wrangler pages secret put GCP_WIF_PRIVATE_KEY`.
GCP_WIF_PRIVATE_KEY=
GCP_WIF_AUDIENCE=//iam.googleapis.com/projects/NNN/locations/global/workloadIdentityPools/POOL/providers/PROVIDER
GCP_WIF_KID=stewardmd-key-1
GCP_WIF_ISSUER=https://stewardmd.in
GCP_WIF_SUBJECT=maik-worker
# Alternative to WIF (only if org policy allows SA keys): a full SA private key PEM.
# GCP_SA_PRIVATE_KEY=

# ---- Developer API (AI Studio) — optional dev/failover ----
# GEMINI_API_KEY=

# ---- Cerebras (clinical text provider — LAST production fallback) ----
# CEREBRAS_API_KEY=
CEREBRAS_MODEL=gemma-4-31b          # MUST be one of your account's models (see /v1/models);
                                    # gemma-4-31b = reliable clean JSON; reasoning models
                                    # (gpt-oss-120b/zai-glm) may emit non-JSON.
# CEREBRAS_BASE=https://api.cerebras.ai/v1

# ---- production mode (Developer/Mock provider is DISABLED unless dev) ----
# FUNDX_ENV=production               # default; set development/preview to re-enable developer
# FUNDX_ALLOW_DEVELOPER=1            # force-enable the developer/AI-Studio provider (dev only)

# ---- KV for rate limiting (binding, not a var) ----
# Reuses the existing MAIK_KV namespace (see wrangler.toml). For `pages dev`, bind a
# preview namespace: `npx wrangler pages dev . --kv MAIK_KV`. Metering fails OPEN if absent.

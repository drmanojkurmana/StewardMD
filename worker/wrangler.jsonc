{
  // StewardMD Drug API — Cloudflare Worker configuration.
  // Deployed independently of the GitHub Pages frontend (via `wrangler deploy`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stewardmd-api",
  "main": "src/index.js",
  "compatibility_date": "2026-06-27",

  // Development: a *.workers.dev URL is provisioned for local/preview testing.
  "workers_dev": true,

  // Production endpoint (Phase 5). Requires the stewardmd.in zone on Cloudflare.
  "routes": [
    { "pattern": "api.stewardmd.in", "custom_domain": true }
  ],

  // Bind the EXISTING D1 database — do NOT create a new one.
  // Exposed to the Worker as `env.DB`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stewardmd-prod",
      "database_id": "2da529c4-c061-4f2f-8ae4-9280c70294b1"
    }
  ],

  // account_id intentionally omitted from source control; wrangler uses the
  // authenticated account. Any secrets go via `wrangler secret put`, never here.
  "observability": { "enabled": true },

  // FDA medical updates every 6h; watch-lab lab poll every 15 min.
  // scheduled() branches on event.cron. Requires the secret UPDATES_ADMIN_TOKEN
  // (wrangler secret put UPDATES_ADMIN_TOKEN), matching the Pages project.
  "triggers": { "crons": ["17 */6 * * *", "*/15 * * * *"] },

  // Edge rate limiting per client IP (protects the open, read-only API).
  "r2_buckets": [
    { "binding": "OFFLINE_BUCKET", "bucket_name": "stewardmd-offline" }
  ],
  "vars": { "FIREBASE_PROJECT_ID": "stewardmd-498ec" },

  "unsafe": {
    "bindings": [
      { "name": "RL", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
    ]
  }
}

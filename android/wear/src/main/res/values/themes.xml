<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Branded launch splash (core-splashscreen). Icon shows on API 31+; on older watches the
         black background alone replaces the blank system "Starting…". -->
    <style name="Theme.SMD.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@android:style/Theme.DeviceDefault</item>
    </style>
</resources>

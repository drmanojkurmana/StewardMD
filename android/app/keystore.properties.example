# StewardMD Android upload signing — copy this to android/app/keystore.properties (GITIGNORED)
# and fill in your UPLOAD keystore. Play App Signing manages the real app key; you sign the AAB
# you upload with this upload key. Generate one:
#   keytool -genkey -v -keystore stewardmd-upload.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias stewardmd-upload
# Then register its SHA-256 as the Play "upload key" (Play Console → App integrity), and ensure the
# Play *App Signing* SHA-256 is already in functions/_middleware.js ASSETLINKS (it is).
storeFile=/absolute/path/to/stewardmd-upload.jks
storePassword=CHANGE_ME
keyAlias=stewardmd-upload
keyPassword=CHANGE_ME

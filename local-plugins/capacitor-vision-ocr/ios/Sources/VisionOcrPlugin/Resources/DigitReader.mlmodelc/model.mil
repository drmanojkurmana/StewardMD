            tensor<fp16, [1, 16, 1, 48]> y_cast_fp16 = conv(bias = head_bias_to_fp16, dilations = y_dilations_0, groups = y_groups_0, pad = y_pad_0, pad_type = y_pad_type_0, strides = y_strides_0, weight = head_weight_to_fp16, x = input_67_cast_fp16)[name = tensor<string, []>("y_cast_fp16")];

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Foreground media playback (targetSdk 36): both permissions are required
         before a mediaPlayback foreground service may start. POST_NOTIFICATIONS
         is already declared by the host app; it is not re-declared here. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application>
        <!-- First-party ambient playback only. Not exported: only this app
             (via PrepSoundPlugin) may start or command it. -->
        <service
            android:name="in.stewardmd.prepsound.PrepSoundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- System media access (rs-android-media): exists ONLY so
             MediaSessionManager.getActiveSessions() can list other music
             apps' sessions after the user enables PrepNucleus under
             Settings > Notification access. It reads NO notification
             content (see PrepMediaListenerService). Only the system may
             bind it (BIND_NOTIFICATION_LISTENER_SERVICE). -->
        <service
            android:name="in.stewardmd.prepsound.PrepMediaListenerService"
            android:exported="true"
            android:label="PrepNucleus media access"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- PrepNucleus widget: same tokens as the iOS tile (white card, teal 0E6E63, ink 14202B, muted 5A7184). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prep_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prep_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/prep_exam"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:letterSpacing="0.04"
        android:textAllCaps="true"
        android:textColor="#0E6E63"
        android:textSize="11sp"
        android:textStyle="bold"
        android:text="@string/prep_widget_label" />

    <LinearLayout
        android:id="@+id/prep_score_row"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/prep_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:textColor="#14202B"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/prep_score_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:text="READINESS / 100"
            android:textColor="#5A7184"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/prep_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#14202B"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/prep_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#5A7184"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/prep_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#5A7184"
        android:textSize="12sp" />
</LinearLayout>

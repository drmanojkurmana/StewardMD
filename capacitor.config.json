{
  "appId": "in.stewardmd.app",
  "appName": "StewardMD",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0d1b26"
  },
  "android": {
    "backgroundColor": "#0d1b26"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": false,
      "backgroundColor": "#0d1b26",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
